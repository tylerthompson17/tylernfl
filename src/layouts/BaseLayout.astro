---
import '../styles/global.css';
import { url } from '../utils/url';
import Panel from '../components/Panel.astro';
import TickerItem from '../components/TickerItem.astro';
import tickerData from '../data/ticker.json';
import onThisDayData from '../data/on_this_day.json';
import modelRecordData from '../data/model_record.json';
import type { TickerData, OnThisDayData, ModelRecordData } from '../data/types';

const ticker = tickerData as TickerData;
const onThisDay = onThisDayData as OnThisDayData;
const modelRecord = modelRecordData as ModelRecordData;

const record =
  modelRecord.pushes > 0
    ? `${modelRecord.wins}-${modelRecord.losses}-${modelRecord.pushes}`
    : `${modelRecord.wins}-${modelRecord.losses}`;
const recordUpdated = new Date(modelRecord.updated).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
});

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Personal NFL analytics: 4th down model, stat leaders, and daily features.' } = Astro.props;

const navItems = [
  { label: 'Home', href: url() },
  { label: 'Stats', href: url('stats') },
  { label: 'Tools', href: url('tools') },
  { label: 'Articles', href: url('articles') },
  { label: 'About', href: url('about') },
];

// Active item: exact match for home, prefix match for sections.
const current = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
function isActive(href: string): boolean {
  if (href === url()) return current === href;
  return current.startsWith(href);
}

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Tyler NFL</title>
  </head>
  <body>
    <div class="shell">
      <div class="ticker" aria-label="Scores">
        <ul class="ticker-track">
          {ticker.games.map((game) => <TickerItem game={game} />)}
        </ul>
      </div>

      <header class="header">
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav">
          Menu
        </button>
        <a class="wordmark" href={url()}>Tyler NFL</a>
        <!-- Search is specced but not built yet. No form wrapper, so
             pressing Enter does nothing instead of faking a submit. -->
        <div class="search">
          <input type="search" placeholder="Search players, teams, stats" aria-label="Search players, teams, stats (not available yet)" />
        </div>
      </header>

      <nav class="nav" id="site-nav" aria-label="Site">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <main class="main" id="main">
        <slot />
      </main>

      <aside class="rail" aria-label="Extras">
        <Panel title="4th down model record">
          <p class="record num">{record}</p>
          <p class="record-sub">{modelRecord.season} season, graded calls, updated {recordUpdated}</p>
        </Panel>
        <Panel title="On this day">
          <ul class="otd">
            {
              onThisDay.items.map((item) => (
                <li>
                  <span class="otd-year num">{item.year}</span>
                  <span>{item.text}</span>
                </li>
              ))
            }
          </ul>
        </Panel>
      </aside>

      <footer class="footer">
        <p>Not affiliated with or endorsed by the NFL or any team.</p>
      </footer>
    </div>

    <script>
      const button = document.querySelector('.menu-button');
      const shell = document.querySelector('.shell');
      button?.addEventListener('click', () => {
        const open = shell?.classList.toggle('nav-open') ?? false;
        button.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>

<style>
  /* Panels sit on the gray page with a 12px gap. Regions that read as
     panels carry their own white background and 1px border; the shell
     itself is just the gray page. */
  .shell {
    min-height: 100vh;
    display: grid;
    grid-template-columns: var(--nav-width) minmax(0, 1fr) var(--rail-width);
    grid-template-rows: auto auto 1fr auto;
    grid-template-areas:
      'ticker ticker ticker'
      'header header header'
      'nav    main   rail'
      'footer footer footer';
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--bg);
  }

  .shell > * {
    min-width: 0;
  }

  /* Ticker: a white strip of boxed game slots */
  .ticker {
    grid-area: ticker;
    overflow-x: auto;
    background: var(--panel);
    border: 1px solid var(--rule);
  }

  .ticker-track {
    display: flex;
    list-style: none;
    padding: 0;
    width: max-content;
  }

  /* Header: slate bar, like a panel header for the whole site */
  .header {
    grid-area: header;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3);
    background: var(--header);
    color: var(--header-text);
  }

  .wordmark {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--header-text);
    text-decoration: none;
  }

  .menu-button {
    display: none;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--rule);
    color: var(--header-text);
  }

  .search {
    margin-left: auto;
  }

  .search input {
    width: 260px;
    padding: var(--space-1) var(--space-2);
    background: var(--panel);
    border: 1px solid var(--rule);
    color: var(--text);
    font: inherit;
  }

  .search input::placeholder {
    color: var(--text-dim);
  }

  /* Left nav: white panel of links */
  .nav {
    grid-area: nav;
    align-self: start;
    padding: var(--space-2) 0;
    background: var(--panel);
    border: 1px solid var(--rule);
  }

  .nav ul {
    list-style: none;
    padding: 0;
  }

  .nav a {
    display: block;
    padding: var(--space-1) var(--space-3);
  }

  .nav a[aria-current='page'] {
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
  }

  /* Main: transparent; pages lay their own panels on the gray */
  .main {
    grid-area: main;
  }

  /* Right rail: stack of panels */
  .rail {
    grid-area: rail;
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  /* Model record */
  .record {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 26px;
    line-height: 1.1;
  }

  .record-sub {
    margin-top: var(--space-1);
    color: var(--text-dim);
    font-size: 12px;
  }

  /* On this day list: dotted dividers between items */
  .otd {
    list-style: none;
    padding: 0;
  }

  .otd li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2);
  }

  .otd li + li {
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px dotted var(--rule-soft);
  }

  .otd-year {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--text-dim);
  }

  /* Footer */
  .footer {
    grid-area: footer;
    color: var(--text-dim);
    font-size: 12px;
  }

  /* Rail moves under main */
  @media (max-width: 1100px) {
    .shell {
      grid-template-columns: var(--nav-width) minmax(0, 1fr);
      grid-template-rows: auto auto 1fr auto auto;
      grid-template-areas:
        'ticker ticker'
        'header header'
        'nav    main'
        'nav    rail'
        'footer footer';
    }
  }

  /* Nav collapses behind a menu button */
  @media (max-width: 760px) {
    .shell {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto auto 1fr auto auto;
      grid-template-areas:
        'ticker'
        'header'
        'nav'
        'main'
        'rail'
        'footer';
    }

    .menu-button {
      display: block;
    }

    .nav {
      display: none;
    }

    .shell.nav-open .nav {
      display: block;
    }

    .search input {
      width: 100%;
    }
  }
</style>

<style is:global>
  /* Page-level building blocks shared by all pages. */
  .placeholder-note {
    color: var(--text-dim);
  }

  /* Panels on the gray page, 12px apart. Each panel brings its own
     border; the container is invisible. */
  .content-grid {
    display: grid;
    gap: var(--space-3);
    align-items: start;
  }

  .page-title {
    font-size: 22px;
    margin-bottom: var(--space-3);
  }
</style>
