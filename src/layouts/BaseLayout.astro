---
import '../styles/global.css';
import { url } from '../utils/url';
import Panel from '../components/Panel.astro';
import TickerItem from '../components/TickerItem.astro';
import tickerData from '../data/ticker.json';
import onThisDayData from '../data/on_this_day.json';
import type { TickerData, GameState, OnThisDayData } from '../data/types';

const ticker = tickerData as TickerData;

// nflverse numbers postseason rounds as weeks 19 to 22.
const postseasonRounds: Record<number, string> = {
  19: 'Wild card',
  20: 'Divisional',
  21: 'Conference',
  22: 'Super Bowl',
};
const weekLabel =
  ticker.week == null ? null : (postseasonRounds[ticker.week] ?? `Week ${ticker.week}`);

// Finished games first, then in progress, then upcoming.
const stateOrder: Record<GameState, number> = { final: 0, live: 1, pre: 2 };
const tickerGames = [...ticker.games].sort((a, b) => stateOrder[a.state] - stateOrder[b.state]);

// Offseason: the ticker's only empty state.
let openerText = 'Offseason.';
if (ticker.nextOpener) {
  const [y, m, d] = ticker.nextOpener.split('-').map(Number);
  const opener = new Date(y!, m! - 1, d!).toLocaleDateString('en-US', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
  openerText = `Offseason. Next season opens ${opener}.`;
}
const onThisDay = onThisDayData as OnThisDayData;

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Personal NFL analytics: 4th down model, stat leaders, and daily features.' } = Astro.props;

const navItems = [
  { label: 'Home', href: url() },
  { label: 'Stats', href: url('stats') },
  { label: 'Tools', href: url('tools') },
  { label: 'Articles', href: url('articles') },
  { label: 'About', href: url('about') },
];

// Active item: exact match for home, prefix match for sections.
const current = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
function isActive(href: string): boolean {
  if (href === url()) return current === href;
  return current.startsWith(href);
}

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Tyler NFL</title>
  </head>
  <body>
    <div class="shell">
      <div class="ticker" aria-label="Scores">
        {
          tickerGames.length > 0 ? (
            <div class="ticker-row">
              {weekLabel && <span class="ticker-week">{weekLabel}</span>}
              <div class="ticker-viewport">
                <div class="ticker-marquee">
                  <ul class="ticker-track">
                    {tickerGames.map((game) => (
                      <TickerItem game={game} />
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ) : (
            <p class="ticker-empty">{openerText}</p>
          )
        }
      </div>

      <header class="header">
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav">
          Menu
        </button>
        <a class="wordmark" href={url()}>Tyler NFL</a>
        <!-- Search is specced but not built yet. No form wrapper, so
             pressing Enter does nothing instead of faking a submit. -->
        <div class="search">
          <input type="search" placeholder="Search players, teams, stats" aria-label="Search players, teams, stats (not available yet)" />
        </div>
      </header>

      <nav class="nav" id="site-nav" aria-label="Site">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <main class="main" id="main">
        <slot />
      </main>

      <aside class="rail" aria-label="Extras">
        <Panel title="4th down model record">
          <p class="coming-soon">Coming soon</p>
          <p class="placeholder-note">
            Once the 4th down model is live, its record on graded calls will show here.
          </p>
        </Panel>
        <Panel title="On this day">
          {
            onThisDay.items.length > 0 ? (
              <ul class="otd">
                {onThisDay.items.map((item) => (
                  <li>
                    <span class="otd-year num">{item.year}</span>
                    <span>{item.text}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="placeholder-note">Nothing on record for today.</p>
            )
          }
        </Panel>
      </aside>

      <footer class="footer">
        <p>Not affiliated with or endorsed by the NFL or any team.</p>
      </footer>
    </div>

    <script>
      const button = document.querySelector('.menu-button');
      const shell = document.querySelector('.shell');
      button?.addEventListener('click', () => {
        const open = shell?.classList.toggle('nav-open') ?? false;
        button.setAttribute('aria-expanded', String(open));
      });
    </script>

    <script>
      // Score ticker carousel. Only runs when the games are wider than the
      // strip, the device can hover (hover and keyboard focus are the only
      // ways to pause it), and the visitor has not asked for reduced motion.
      // Otherwise the static, hand-scrollable strip stays in place.
      const PIXELS_PER_SECOND = 36;

      function initTicker(
        ticker: HTMLElement,
        viewport: HTMLElement,
        marquee: HTMLElement,
        track: HTMLElement
      ) {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const canHover = window.matchMedia('(hover: hover)');
        let clone: HTMLElement | null = null;

        function update() {
          const shouldRun =
            canHover.matches && !reducedMotion.matches && track.offsetWidth > viewport.clientWidth;

          if (shouldRun && !clone) {
            // Second copy makes the loop seamless. Hidden from screen
            // readers and the tab order so each game is announced once.
            clone = track.cloneNode(true) as HTMLElement;
            clone.setAttribute('aria-hidden', 'true');
            clone.inert = true;
            marquee.append(clone);
          } else if (!shouldRun && clone) {
            clone.remove();
            clone = null;
          }

          ticker.classList.toggle('is-running', shouldRun);
          marquee.style.setProperty('--ticker-duration', `${track.offsetWidth / PIXELS_PER_SECOND}s`);
        }

        new ResizeObserver(update).observe(viewport);
        reducedMotion.addEventListener('change', update);
        canHover.addEventListener('change', update);
        update();
      }

      const ticker = document.querySelector<HTMLElement>('.ticker');
      const viewport = ticker?.querySelector<HTMLElement>('.ticker-viewport');
      const marquee = ticker?.querySelector<HTMLElement>('.ticker-marquee');
      const track = ticker?.querySelector<HTMLElement>('.ticker-track');
      if (ticker && viewport && marquee && track) {
        initTicker(ticker, viewport, marquee, track);
      }
    </script>
  </body>
</html>

<style>
  /* Panels sit on the gray page with a 12px gap. Regions that read as
     panels carry their own white background and 1px border; the shell
     itself is just the gray page. */
  .shell {
    min-height: 100vh;
    display: grid;
    grid-template-columns: var(--nav-width) minmax(0, 1fr) var(--rail-width);
    grid-template-rows: auto auto 1fr auto;
    grid-template-areas:
      'ticker ticker ticker'
      'header header header'
      'nav    main   rail'
      'footer footer footer';
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--bg);
  }

  .shell > * {
    min-width: 0;
  }

  /* Ticker: a white strip of boxed game slots */
  .ticker {
    grid-area: ticker;
    background: var(--panel);
    border: 1px solid var(--rule);
  }

  .ticker-row {
    display: flex;
  }

  /* Week label sits outside the moving strip, so it never scrolls away */
  .ticker-week {
    flex: none;
    display: flex;
    align-items: center;
    padding: var(--header-pad);
    background: var(--header);
    color: var(--header-text);
    font-family: var(--font-heading);
    font-weight: 700;
    white-space: nowrap;
  }

  /* Static by default: the strip scrolls by hand. The script below
     switches to a looping carousel when the games overflow. */
  .ticker-viewport {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
  }

  .ticker-marquee {
    display: flex;
    width: max-content;
  }

  .ticker-track {
    display: flex;
    list-style: none;
    padding: 0;
    width: max-content;
  }

  /* Carousel: two copies of the track slide left by one copy's width,
     then loop seamlessly. Pauses on hover and on keyboard focus, which
     are the pause mechanisms, so it only runs on devices that can hover. */
  .ticker.is-running .ticker-viewport {
    overflow: hidden;
  }

  .ticker.is-running .ticker-marquee {
    animation: ticker-scroll var(--ticker-duration, 60s) linear infinite;
  }

  .ticker.is-running .ticker-viewport:hover .ticker-marquee,
  .ticker.is-running .ticker-viewport:focus-within .ticker-marquee {
    animation-play-state: paused;
  }

  @keyframes ticker-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker.is-running .ticker-marquee {
      animation: none;
    }
  }

  .ticker-empty {
    padding: var(--space-2) var(--space-3);
    color: var(--text-dim);
  }

  /* Header: slate bar, like a panel header for the whole site */
  .header {
    grid-area: header;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3);
    background: var(--header);
    color: var(--header-text);
  }

  .wordmark {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--header-text);
    text-decoration: none;
  }

  .menu-button {
    display: none;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--rule);
    color: var(--header-text);
  }

  .search {
    margin-left: auto;
    flex-shrink: 1;
    min-width: 0;
  }

  .search input {
    width: 260px;
    max-width: 100%;
    padding: var(--space-1) var(--space-2);
    background: var(--panel);
    border: 1px solid var(--rule);
    color: var(--text);
    font: inherit;
  }

  .search input::placeholder {
    color: var(--text-dim);
  }

  /* Left nav: white panel of links */
  .nav {
    grid-area: nav;
    align-self: start;
    padding: var(--space-2) 0;
    background: var(--panel);
    border: 1px solid var(--rule);
  }

  .nav ul {
    list-style: none;
    padding: 0;
  }

  .nav a {
    display: block;
    padding: var(--space-1) var(--space-3);
  }

  .nav a:hover {
    background: var(--bg);
  }

  .nav a[aria-current='page'] {
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
  }

  /* Main: transparent; pages lay their own panels on the gray */
  .main {
    grid-area: main;
  }

  /* Right rail: stack of panels */
  .rail {
    grid-area: rail;
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  /* Model record placeholder */
  .coming-soon {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.2;
  }

  /* On this day list: dotted dividers between items */
  .otd {
    list-style: none;
    padding: 0;
  }

  .otd li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2);
  }

  .otd li + li {
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px dotted var(--rule-soft);
  }

  .otd-year {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--text-dim);
  }

  /* Footer */
  .footer {
    grid-area: footer;
    color: var(--text-dim);
    font-size: 12px;
  }

  /* Rail moves under main */
  @media (max-width: 1100px) {
    .shell {
      grid-template-columns: var(--nav-width) minmax(0, 1fr);
      grid-template-rows: auto auto 1fr auto auto;
      grid-template-areas:
        'ticker ticker'
        'header header'
        'nav    main'
        'nav    rail'
        'footer footer';
    }
  }

  /* Nav collapses behind a menu button */
  @media (max-width: 760px) {
    .shell {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto auto 1fr auto auto;
      grid-template-areas:
        'ticker'
        'header'
        'nav'
        'main'
        'rail'
        'footer';
    }

    .menu-button {
      display: block;
    }

    .nav {
      display: none;
    }

    .shell.nav-open .nav {
      display: block;
    }

    .search input {
      width: 100%;
    }
  }
</style>

<style is:global>
  /* Page-level building blocks shared by all pages. */
  .placeholder-note {
    color: var(--text-dim);
  }

  /* Panels on the gray page, 12px apart. Each panel brings its own
     border; the container is invisible. */
  .content-grid {
    display: grid;
    gap: var(--space-3);
    align-items: start;
  }

  .page-title {
    font-size: 22px;
    margin-bottom: var(--space-3);
  }
</style>
