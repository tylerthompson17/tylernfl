---
import '../styles/global.css';
import { url } from '../utils/url';
import { BUILD_ID } from '../utils/build';
import Panel from '../components/Panel.astro';
import TickerItem from '../components/TickerItem.astro';
import tickerData from '../data/ticker.json';
import onThisDayData from '../data/on_this_day.json';
import type { TickerData, GameState, OnThisDayData } from '../data/types';
import { weekLabel } from '../utils/week';

const ticker = tickerData as TickerData;

const week = weekLabel(ticker.week);

// Live games are pinned ahead of the strip, which runs finished games,
// then upcoming. The daily data never marks a game live, so in practice the
// browser pins games as they kick off (src/lib/live-ticker/client.ts).
const stateOrder: Record<GameState, number> = { final: 0, live: 1, pre: 2 };
const tickerGames = [...ticker.games].sort((a, b) => stateOrder[a.state] - stateOrder[b.state]);
const pinnedGames = tickerGames.filter((game) => game.state === 'live');
const stripGames = tickerGames.filter((game) => game.state !== 'live');

// Offseason: the ticker's only empty state.
let openerText = 'Offseason.';
if (ticker.nextOpener) {
  const [y, m, d] = ticker.nextOpener.split('-').map(Number);
  const opener = new Date(y!, m! - 1, d!).toLocaleDateString('en-US', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
  openerText = `Offseason. Next season opens ${opener}.`;
}
const onThisDay = onThisDayData as OnThisDayData;

// Versioned per build so a deploy never pairs new pages with a cached index.
const searchIndexUrl = `${url('search-index.js')}?v=${BUILD_ID}`;
const onThisDayDate = new Date(2000, onThisDay.month - 1, onThisDay.day).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
});

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Personal NFL analytics: 4th down model, stat leaders, and daily features.' } = Astro.props;

const navItems = [
  { label: 'Home', href: url() },
  { label: 'Standings', href: url('standings') },
  { label: 'Stats', href: url('stats') },
  { label: 'Charts', href: url('charts') },
  { label: 'Transactions', href: url('transactions') },
  { label: 'Tools', href: url('tools') },
  { label: 'Articles', href: url('articles') },
  { label: 'Curated', href: url('curated') },
  { label: 'About', href: url('about') },
];

// Active item: exact match for home, prefix match for sections.
const current = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
function isActive(href: string): boolean {
  if (href === url()) return current === href;
  return current.startsWith(href);
}

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Tyler NFL</title>
  </head>
  <body>
    <div class="shell">
      <div
        class="ticker"
        aria-label="Scores"
        data-season={ticker.season}
        data-week={ticker.week ?? undefined}
      >
        {
          tickerGames.length > 0 ? (
            <div class="ticker-row" data-row>
              {
                week && (
                  <a class="ticker-week" data-week href={url('scores')}>
                    {week}
                  </a>
                )
              }
              <div class="ticker-group ticker-live" data-live hidden={pinnedGames.length === 0}>
                <div class="ticker-marquee">
                  <ul class="ticker-list ticker-pinned" data-pinned aria-label="Live now">
                    {pinnedGames.map((game) => (
                      <TickerItem game={game} />
                    ))}
                  </ul>
                </div>
              </div>
              <div class="ticker-group ticker-rest" data-rest hidden={stripGames.length === 0}>
                <div class="ticker-marquee">
                  <ul class="ticker-list ticker-track" aria-label="This week">
                    {stripGames.map((game) => (
                      <TickerItem game={game} />
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ) : (
            <p class="ticker-empty">{openerText}</p>
          )
        }
      </div>

      <header class="header">
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav">
          Menu
        </button>
        <a class="wordmark" href={url()}>Tyler NFL</a>
        <!-- Search runs in the browser over search-index.js, built with the
             site. No form wrapper: without JavaScript the box stays disabled
             rather than pretending to submit. -->
        <div class="search">
          <input
            type="search"
            placeholder="Search players, teams, stats"
            aria-label="Search players, teams and pages"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="search-results"
            autocomplete="off"
            spellcheck="false"
            disabled
            data-search-input
            data-index={searchIndexUrl}
          />
          <ul id="search-results" class="search-results" role="listbox" aria-label="Search results" hidden data-search-results></ul>
          <p class="visually-hidden" aria-live="polite" data-search-status></p>
        </div>
      </header>

      <nav class="nav" id="site-nav" aria-label="Site">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <main class="main" id="main">
        <slot />
      </main>

      <aside class="rail" aria-label="Extras">
        <Panel title="4th down model record">
          <p class="coming-soon">Coming soon</p>
          <p class="placeholder-note">
            Once the 4th down model is live, its record on graded calls will show here.
          </p>
        </Panel>
        <Panel title={`On this day, ${onThisDayDate}`}>
          {
            onThisDay.items.length > 0 ? (
              <ul class="otd">
                {onThisDay.items.map((item) => (
                  <li>
                    <span class="otd-year num">{item.year}</span>
                    <span>
                      {item.parts.map((part) =>
                        part.team ? <a href={url(`teams/${part.team}`)}>{part.text}</a> : part.text
                      )}
                    </span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="placeholder-note">
                {onThisDay.gamesOnDate === 0
                  ? 'No NFL games on this date since 1999.'
                  : 'No standout games on this date since 1999.'}
              </p>
            )
          }
          <p class="otd-source">Games since 1999, from nflverse schedules.</p>
        </Panel>
      </aside>

      <footer class="footer">
        <p>Not affiliated with or endorsed by the NFL or any team.</p>
      </footer>
    </div>

    <script>
      const button = document.querySelector('.menu-button');
      const shell = document.querySelector('.shell');
      button?.addEventListener('click', () => {
        const open = shell?.classList.toggle('nav-open') ?? false;
        button.setAttribute('aria-expanded', String(open));
      });
    </script>

    <script>
      import { initSearch } from '../lib/search/dom';

      initSearch();
    </script>

    <script>
      import { initLiveTicker } from '../lib/live-ticker/client.ts';

      initLiveTicker();
    </script>

    <script>
      // Score ticker layout. The row is two groups of games: the live ones,
      // which take the width they need, and the rest of the week, which gets
      // the remainder and is dropped when that is under one game slot. Either
      // group loops as a carousel when its games are wider than its share of
      // the row, the device can hover (hover and keyboard focus are the only
      // ways to pause it), and the visitor has not asked for reduced motion.
      // Otherwise the group stays a static, hand-scrollable strip.
      //
      // The carousel steps: it rests on a game, then slides one game's width,
      // so it always stops with whole games showing. A continuous scroll had
      // the leftmost game half under the week label nearly all the time.
      import { CAROUSEL_MOVE_MS, CAROUSEL_REST_MS, carouselOffset, showsStrip } from '../lib/live-ticker/pin.ts';

      // Matches the ticker's stacked layout below, where the whole row is one
      // hand-scrolled strip and neither group is given a share of the width.
      const STACKED = '(max-width: 760px)';

      interface Group {
        group: HTMLElement;
        marquee: HTMLElement;
        track: HTMLElement;
        clone: HTMLElement | null;
        /** Games moved past since the loop last began. */
        steps: number;
        timer: number | undefined;
        paused: boolean;
      }

      function readGroup(row: HTMLElement, selector: string): Group | null {
        const group = row.querySelector<HTMLElement>(selector);
        const marquee = group?.querySelector<HTMLElement>('.ticker-marquee');
        const track = group?.querySelector<HTMLElement>('.ticker-list');
        if (!group || !marquee || !track) return null;
        const g: Group = { group, marquee, track, clone: null, steps: 0, timer: undefined, paused: false };
        // Hover and keyboard focus hold the carousel where it is.
        group.addEventListener('mouseenter', () => (g.paused = true));
        group.addEventListener('mouseleave', () => (g.paused = group.contains(document.activeElement)));
        group.addEventListener('focusin', () => (g.paused = true));
        group.addEventListener('focusout', (event) => {
          g.paused = group.contains(event.relatedTarget as Node | null) || group.matches(':hover');
        });
        return g;
      }

      function place(g: Group, animate: boolean) {
        const widths = [...g.track.children].map((slot) => slot.getBoundingClientRect().width);
        g.marquee.classList.toggle('is-moving', animate);
        g.marquee.style.transform = `translateX(${-carouselOffset(widths, g.steps)}px)`;
      }

      function step(g: Group) {
        if (g.paused || document.hidden) return;
        g.steps += 1;
        place(g, true);
        // After a whole copy has gone by, the copy behind it is in exactly
        // the starting place: jump back to the start without moving.
        if (g.steps >= g.track.children.length) {
          window.setTimeout(() => {
            g.steps = 0;
            place(g, false);
          }, CAROUSEL_MOVE_MS);
        }
      }

      function stop(g: Group) {
        window.clearInterval(g.timer);
        g.timer = undefined;
        g.steps = 0;
        g.marquee.classList.remove('is-moving');
        g.marquee.style.transform = '';
      }

      function initTicker(row: HTMLElement, live: Group, rest: Group) {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const canHover = window.matchMedia('(hover: hover)');
        const stacked = window.matchMedia(STACKED);

        function run(g: Group) {
          const shouldRun =
            canHover.matches &&
            !reducedMotion.matches &&
            !g.group.hidden &&
            g.track.offsetWidth > g.group.clientWidth;

          if (shouldRun && !g.clone) {
            // Second copy makes the loop seamless. Hidden from screen
            // readers and the tab order so each game is announced once.
            g.clone = g.track.cloneNode(true) as HTMLElement;
            g.clone.setAttribute('aria-hidden', 'true');
            g.clone.inert = true;
            g.marquee.append(g.clone);
          } else if (!shouldRun && g.clone) {
            g.clone.remove();
            g.clone = null;
          }

          g.group.classList.toggle('is-running', shouldRun);
          if (!shouldRun) stop(g);
          else if (g.timer === undefined) {
            g.timer = window.setInterval(() => step(g), CAROUSEL_REST_MS + CAROUSEL_MOVE_MS);
          }
        }

        function update() {
          const week = row.querySelector<HTMLElement>('[data-week]');
          const used = (week?.offsetWidth ?? 0) + (live.group.hidden ? 0 : live.group.offsetWidth);
          // Hiding the strip gives its width back to nobody: the live group
          // never grows, and when it is already shrunk the strip had nothing
          // to give. So this measurement cannot feed back into itself.
          rest.group.hidden = stacked.matches
            ? rest.track.children.length === 0
            : !showsStrip(row.clientWidth - used, rest.track.children.length);

          run(live);
          run(rest);
        }

        // Games move between the groups as they kick off and finish; rebuild
        // the decorative copies so they match.
        for (const g of [live, rest]) {
          new MutationObserver(() => {
            g.clone?.remove();
            g.clone = null;
            stop(g);
            update();
          }).observe(g.track, { childList: true });
        }

        new ResizeObserver(update).observe(row);
        reducedMotion.addEventListener('change', update);
        canHover.addEventListener('change', update);
        stacked.addEventListener('change', update);
        update();
      }

      const row = document.querySelector<HTMLElement>('.ticker [data-row]');
      const live = row && readGroup(row, '[data-live]');
      const rest = row && readGroup(row, '[data-rest]');
      if (row && live && rest) initTicker(row, live, rest);
    </script>
  </body>
</html>

<style>
  /* Panels sit on the gray page with a 12px gap. Regions that read as
     panels carry their own white background and 1px border; the shell
     itself is just the gray page. */
  .shell {
    min-height: 100vh;
    display: grid;
    grid-template-columns: var(--nav-width) minmax(0, 1fr) var(--rail-width);
    grid-template-rows: auto auto 1fr auto;
    grid-template-areas:
      'ticker ticker ticker'
      'header header header'
      'nav    main   rail'
      'footer footer footer';
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--bg);
  }

  .shell > * {
    min-width: 0;
  }

  /* Ticker: a white strip of boxed game slots */
  .ticker {
    grid-area: ticker;
    background: var(--panel);
    border: 1px solid var(--rule);
  }

  .ticker-row {
    display: flex;
  }

  /* Week label sits outside the moving strip, so it never scrolls away.
     It links to the full slate; like the team links in a game slot it
     keeps the bar's color and underlines on hover, since blue underlined
     text on the slate bar would not read as a header. */
  .ticker-week {
    flex: none;
    display: flex;
    align-items: center;
    padding: var(--header-pad);
    background: var(--header);
    color: var(--header-text);
    font-family: var(--font-heading);
    font-weight: 700;
    white-space: nowrap;
    text-decoration: none;
  }

  .ticker-week:hover {
    text-decoration: underline;
  }

  /* The global blue focus ring is about 2:1 against the slate bars, under
     the 3:1 a focus indicator needs. Links sitting on slate take a white
     ring instead. */
  .ticker-week:focus-visible,
  .wordmark:focus-visible {
    outline-color: var(--header-text);
  }

  /* The row holds two groups of games: live ones first, then the rest of
     the week. Each scrolls by hand by default; the script below turns one
     into a looping carousel when its games overflow its share of the row. */
  .ticker-group {
    min-width: 0;
    overflow-x: auto;
  }

  .ticker-group[hidden] {
    display: none;
  }

  /* Live games take the width they need, up to the whole row. They never
     grow into empty space, and a full slate shrinks them (flex-basis 0
     leaves the strip nothing to give back), so on a busy Sunday the live
     games are the row. */
  .ticker-live {
    flex: 0 1 auto;
    border-right: 1px solid var(--header);
  }

  /* The rest of the week gets what is left. The script hides it once that
     is narrower than a game slot. */
  .ticker-rest {
    flex: 1 1 0;
  }

  .ticker-marquee {
    display: flex;
    width: max-content;
  }

  .ticker-list {
    display: flex;
    list-style: none;
    padding: 0;
    width: max-content;
  }

  /* Carousel: two copies of the list, moved one game at a time by the
     script below, which rests on each game and loops seamlessly. Hover
     and keyboard focus hold it, which are the pause mechanisms, so it only
     runs on devices that can hover. The move is 400ms; the script keeps
     the timing (CAROUSEL_MOVE_MS in src/lib/live-ticker/pin.ts). */
  .ticker-group.is-running {
    overflow: hidden;
  }

  .ticker-marquee.is-moving {
    transition: transform 400ms ease-in-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-marquee.is-moving {
      transition: none;
    }
  }

  .ticker-empty {
    padding: var(--space-2) var(--space-3);
    color: var(--text-dim);
  }

  /* Header: slate bar, like a panel header for the whole site */
  .header {
    grid-area: header;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3);
    background: var(--header);
    color: var(--header-text);
  }

  .wordmark {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--header-text);
    text-decoration: none;
  }

  .menu-button {
    display: none;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--rule);
    color: var(--header-text);
  }

  .search {
    margin-left: auto;
    flex-shrink: 1;
    min-width: 0;
  }

  .search input {
    width: 260px;
    max-width: 100%;
    padding: var(--space-1) var(--space-2);
    background: var(--panel);
    border: 1px solid var(--rule);
    color: var(--text);
    font: inherit;
  }

  .search input::placeholder {
    color: var(--text-dim);
  }

  /* Results drop below the box: one boxed list, the chosen row on the
     first-down yellow background (background only, never text). */
  .search {
    position: relative;
  }

  .search-results {
    position: absolute;
    top: calc(100% + 2px);
    right: 0;
    z-index: 10;
    width: max(100%, 320px);
    max-width: calc(100vw - 2 * var(--space-3));
    list-style: none;
    padding: 0;
    background: var(--panel);
    border: 1px solid var(--rule);
    color: var(--text);
  }

  .search-results[hidden] {
    display: none;
  }

  .search-results :global(li) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-1) var(--space-2);
    cursor: pointer;
  }

  .search-results :global(li + li) {
    border-top: 1px dotted var(--rule-soft);
  }

  .search-results :global(li[aria-selected='true']) {
    background: var(--highlight);
  }

  .search-results :global(.search-label) {
    font-weight: 700;
  }

  .search-results :global(.search-detail) {
    color: var(--text-dim);
    white-space: nowrap;
  }

  .search-results :global(li[aria-selected='true'] .search-detail) {
    color: var(--text);
  }

  .search-results :global(.search-empty) {
    color: var(--text-dim);
    cursor: default;
  }

  /* Left nav: white panel of links */
  .nav {
    grid-area: nav;
    align-self: start;
    padding: var(--space-2) 0;
    background: var(--panel);
    border: 1px solid var(--rule);
  }

  .nav ul {
    list-style: none;
    padding: 0;
  }

  .nav a {
    display: block;
    padding: var(--space-1) var(--space-3);
  }

  .nav a:hover {
    background: var(--bg);
  }

  .nav a[aria-current='page'] {
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
  }

  /* Main: transparent; pages lay their own panels on the gray */
  .main {
    grid-area: main;
  }

  /* Right rail: stack of panels */
  .rail {
    grid-area: rail;
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  /* Model record placeholder */
  .coming-soon {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.2;
  }

  /* On this day list: dotted dividers between items */
  .otd {
    list-style: none;
    padding: 0;
  }

  .otd li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2);
  }

  .otd li + li {
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px dotted var(--rule-soft);
  }

  .otd-source {
    margin-top: var(--space-2);
    font-size: 12px;
    color: var(--text-dim);
  }

  .otd-year {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--text-dim);
  }

  /* Footer */
  .footer {
    grid-area: footer;
    color: var(--text-dim);
    font-size: 12px;
  }

  /* Rail moves under main */
  @media (max-width: 1100px) {
    .shell {
      grid-template-columns: var(--nav-width) minmax(0, 1fr);
      grid-template-rows: auto auto 1fr auto auto;
      grid-template-areas:
        'ticker ticker'
        'header header'
        'nav    main'
        'nav    rail'
        'footer footer';
    }
  }

  /* Nav collapses behind a menu button */
  @media (max-width: 760px) {
    /* Too narrow to pin: the whole row becomes one hand-scrolled strip
       with live games first. The strip then never overflows its own
       viewport, so the carousel stays off. */
    .ticker-row {
      overflow-x: auto;
    }

    /* The row scrolls as a whole here; the week label stays put. */
    .ticker-week {
      position: sticky;
      left: 0;
      z-index: 1;
    }

    .ticker-group {
      flex: none;
      overflow-x: visible;
    }

    .shell {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto auto 1fr auto auto;
      grid-template-areas:
        'ticker'
        'header'
        'nav'
        'main'
        'rail'
        'footer';
    }

    .menu-button {
      display: block;
    }

    .nav {
      display: none;
    }

    .shell.nav-open .nav {
      display: block;
    }

    .search input {
      width: 100%;
    }
  }
</style>

<style is:global>
  /* Page-level building blocks shared by all pages. */
  .placeholder-note {
    color: var(--text-dim);
  }

  /* Panels on the gray page, 12px apart. Each panel brings its own
     border; the container is invisible. */
  .content-grid {
    display: grid;
    gap: var(--space-3);
    align-items: start;
  }

  .page-title {
    font-size: 22px;
    margin-bottom: var(--space-3);
  }
</style>
