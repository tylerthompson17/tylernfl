---
/**
 * tt4th's comparison page, unlisted: no link from the nav or any page, not
 * in search, robots noindex (CLAUDE.md). The 4th down calculator's tt4th
 * comparison (ComparisonCalculator.astro), then the latest week's 4th
 * downs with a stored pre-game tt4th result, each loadable into it.
 * Per-play numbers only (contract v5): no outcomes, accuracy, records or
 * WP-cost tallies.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Panel from '../../components/Panel.astro';
import ComparisonCalculator from '../../components/fourth-down/ComparisonCalculator.astro';
import ModelComparison from '../../components/fourth-down/ModelComparison.astro';
import TermBreakdown from '../../components/fourth-down/TermBreakdown.astro';
import '../../styles/model-compare.css';
import { decisionsData } from '../../utils/decisions';
import { gameHref, gamePages } from '../../utils/games';
import { playAnchor } from '../../lib/games/view';
import { disagreeLine, weekList } from '../../lib/model-compare/week';
import { TT4TH_CREDITS } from '../../lib/model-compare/credits';

const kickoffs = new Map(gamePages.map((g) => [g.id, g.kickoff]));
const list = decisionsData ? weekList(decisionsData.fourthDowns, decisionsData.season, (id) => kickoffs.get(id) ?? null) : null;
const callHref = (gameId: string, playId: number) => {
  const href = gameHref(gameId);
  return href ? `${href}#${playAnchor(playId)}` : null;
};
---

<BaseLayout
  title="tt4th and nfl4th"
  description="tt4th, Tyler's 4th down model built on nfl4th, next to nfl4th, with its per-term breakdown."
  noindex
>
  <h1 class="page-title">tt4th and nfl4th</h1>
  <p class="page-intro">
    tt4th next to nfl4th on the same 4th down, with tt4th's adjustments term by term. tt4th is still being
    confirmed, so this page shows each play's numbers only, never how its calls turned out.
  </p>
  <p class="page-intro" set:html={TT4TH_CREDITS} />

  <ComparisonCalculator punterIds={list?.items.map((i) => i.values.punter).filter(Boolean) ?? []} />

  <Panel title={list ? `Week ${list.week} 4th downs` : '4th downs'} class="x-week">
    {
      list ? (
        <div data-experimental-list>
          <div class="x-week-head">
            <p>
              Every week {list.week} 4th down with tt4th's result stored before the game, newest first.{' '}
              {disagreeLine(list)}
            </p>
            <label class="x-filter">
              <input type="checkbox" data-disagree-filter /> Only where the models disagree
            </label>
            <p class="x-shown" data-shown aria-live="polite" />
          </div>
          <div class="x-items">
            {list.items.map((item) => {
              const href = callHref(item.gameId, item.playId);
              return (
                <article class="x-item" data-item data-disagree={item.disagree ? '' : undefined}>
                  <p class="x-game">{href ? <a href={href}>{item.game}</a> : item.game}</p>
                  <p class="x-down">{item.situation}</p>
                  <ModelComparison result={item.result} team={item.team} />
                  <details class="x-breakdown">
                    <summary>Per-term breakdown</summary>
                    <TermBreakdown result={item.result} />
                  </details>
                  <button type="button" class="x-load" data-load={JSON.stringify(item.values)}>
                    Load into the calculator
                  </button>
                </article>
              );
            })}
          </div>
          <p class="x-empty" data-filter-empty hidden>The models agree on every one.</p>
        </div>
      ) : (
        <p class="x-empty">No 4th down has a stored tt4th result yet.</p>
      )
    }
  </Panel>
</BaseLayout>

<style>
  .page-intro {
    color: var(--text-dim);
    margin-bottom: var(--space-3);
    max-width: 80ch;
  }


  .x-week-head {
    margin-bottom: var(--space-3);
  }

  .x-week-head p {
    margin: 0;
  }

  .x-filter {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-2);
  }

  .x-shown {
    color: var(--text-dim);
  }

  .x-items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
    gap: var(--space-3);
  }

  .x-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
    padding: var(--space-2);
    border: 1px solid var(--rule);
  }

  .x-item[hidden] {
    display: none;
  }

  .x-item p {
    margin: 0;
  }

  .x-game {
    color: var(--text-dim);
    font-size: 12px;
  }

  .x-down {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15px;
  }

  .x-breakdown summary {
    cursor: pointer;
    color: var(--link);
    text-decoration: underline;
    width: fit-content;
  }

  .x-breakdown[open] summary {
    margin-bottom: var(--space-1);
  }

  .x-load {
    align-self: flex-start;
    margin-top: auto;
    font: inherit;
    color: var(--link);
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 2px var(--space-2);
    cursor: pointer;
  }

  .x-load:hover {
    background: var(--row-hover);
  }

  .x-empty {
    color: var(--text-dim);
  }
</style>
