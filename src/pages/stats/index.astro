---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Panel from '../../components/Panel.astro';
import StatTable from '../../components/StatTable.astro';
import leadersData from '../../data/leaders.json';
import { url } from '../../utils/url';
import type { LeadersData } from '../../data/types';

const leaders = leadersData as LeadersData;

function columnsFor(valueLabel: string) {
  return [
    { key: 'rank', label: 'Rk', kind: 'number' as const },
    { key: 'player', label: 'Player', kind: 'player' as const },
    { key: 'team', label: 'Team', kind: 'team' as const },
    { key: 'value', label: valueLabel, kind: 'number' as const },
  ];
}
---

<BaseLayout title="Stat leaders">
  <h1 class="page-title">Stat leaders</h1>
  <p class="page-intro">
    {leaders.season} season, through week {leaders.throughWeek}. Team offense and defense ranks
    are on <a href={url('stats/teams')}>Team stats</a>.
  </p>
  <div class="content-grid stats-grid">
    {
      leaders.categories.length > 0 ? (
        leaders.categories.map((category) => (
          <Panel title={category.label}>
            <StatTable
              columns={columnsFor(category.valueLabel)}
              rows={category.rows}
              caption={`${category.label} leaders`}
              emptyText="No games played yet. Leaders appear after week 1."
            />
          </Panel>
        ))
      ) : (
        <Panel title="Stat leaders">
          <p class="placeholder-note">No games played yet. Leaders appear after week 1.</p>
        </Panel>
      )
    }
  </div>
</BaseLayout>

<style>
  .page-intro {
    color: var(--text-dim);
    margin-bottom: var(--space-4);
    font-variant-numeric: tabular-nums;
  }

  /* One column by default; two on wide screens, with an odd last table
     spanning the full row so no empty track exposes the rule color. */
  .stats-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 1200px) {
    .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stats-grid > :global(section:last-child:nth-child(odd)) {
      grid-column: 1 / -1;
    }
  }
</style>
