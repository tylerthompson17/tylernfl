---
/**
 * Stat leaders: the top 5 in eight categories, in equal panels. Six come
 * from the daily leaderboards, the two EPA panels from the weekly
 * player_epa.json (src/utils/overview.ts).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Panel from '../../components/Panel.astro';
import StatTable from '../../components/StatTable.astro';
import StatsNav from '../../components/StatsNav.astro';
import { boardSeason, overviewPanels, type Leaders } from '../../utils/overview';
import { url } from '../../utils/url';

const panels = overviewPanels();
const season = boardSeason();

function columnsFor(panel: Leaders) {
  return [
    { key: 'rank', label: 'Rk', kind: 'number' as const },
    { key: 'player', label: 'Player', kind: 'player' as const, slugKey: 'slug' },
    { key: 'team', label: 'Team', kind: 'team' as const },
    { key: 'value', label: panel.valueLabel, kind: 'number' as const },
    ...(panel.extraLabel ? [{ key: 'extra', label: panel.extraLabel, kind: 'number' as const }] : []),
  ];
}
---

<BaseLayout title="Stat leaders">
  <h1 class="page-title">Stat leaders</h1>
  <StatsNav current="index" />
  <p class="page-intro">
    {season ? `${season} regular season.` : ''} The top 5 in each category, with equal values sharing
    a rank. The full leaderboards sort by any column and switch to per game.
  </p>
  <div class="leaders-grid">
    {
      panels.map((panel) => (
        <Panel title={panel.label}>
          <StatTable
            columns={columnsFor(panel)}
            rows={panel.rows}
            caption={`${panel.label} leaders`}
            emptyText="No games played yet. Leaders appear after week 1."
          />
          <p class="table-foot">
            {panel.moreTied > 0 && (
              <>
                {panel.moreTied} more tied at {panel.tiedValue}.{' '}
              </>
            )}
            {panel.through} {panel.qualifier}{' '}
            {panel.link && <a href={url(panel.link.href)}>{panel.link.text}</a>}
          </p>
        </Panel>
      ))
    }
  </div>
</BaseLayout>

<style>
  .page-intro {
    color: var(--text-dim);
    margin-bottom: var(--space-4);
  }

  /* Equal panels, as many to a row as fit at 300px: two in the main
     column at laptop widths, three when the rail moves under it, one on
     a phone. */
  .leaders-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-3);
    align-items: stretch;
  }

  .leaders-grid > :global(section) {
    display: flex;
    flex-direction: column;
  }

  .leaders-grid > :global(section) > :global(.panel-body) {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .table-foot {
    margin-top: auto;
    padding-top: var(--space-2);
    color: var(--text-dim);
    font-size: 12px;
  }

  @media (max-width: 760px) {
    .leaders-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
