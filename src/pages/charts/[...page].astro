---
/**
 * The chart gallery: Tyler's charts and the auto chart each day was
 * given, newest first, 12 to a page (/charts/, /charts/2/). Auto charts
 * are tagged Auto.
 *
 * Every other game's win probability chart is kept but not listed here;
 * a season of them would bury the rest. The team rows below count all of
 * them, since that is what a team's page lists.
 *
 * Filters are links to static pages, one per tag (/charts/tag/auto/) and
 * one per team a chart is about (/charts/team/KC/); no script.
 */
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Panel from '../../components/Panel.astro';
import ChartList from '../../components/ChartList.astro';
import { CHARTS_PER_PAGE, chartTags, chartTeams, getCharts, getGalleryCharts, type Chart } from '../../utils/charts';
import { url } from '../../utils/url';

export const getStaticPaths = (async ({ paginate }) => {
  const listed = await getGalleryCharts();
  return paginate(listed, {
    pageSize: CHARTS_PER_PAGE,
    props: { tags: chartTags(listed), teams: chartTeams(await getCharts()) },
  });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Chart>;
  tags: ReturnType<typeof chartTags>;
  teams: ReturnType<typeof chartTeams>;
}

const { page, tags, teams } = Astro.props;
---

<BaseLayout title={page.currentPage > 1 ? `Charts, page ${page.currentPage}` : 'Charts'}>
  <h1 class="page-title">Charts</h1>
  {
    page.total === 0 ? (
      <div class="content-grid">
        <Panel title="No charts yet">
          <p class="placeholder-note">The first chart is being drawn.</p>
        </Panel>
      </div>
    ) : (
      <>
        {tags.length > 0 && (
          <nav class="tag-bar" aria-label="Chart tags">
            <span class="tag-label">Tags:</span>
            {tags.map((tag) => (
              <a href={url(`charts/tag/${tag.slug}`)}>
                {tag.label} <span class="count num">({tag.count})</span>
              </a>
            ))}
          </nav>
        )}
        {teams.length > 0 && (
          <nav class="tag-bar" aria-label="Chart teams">
            <span class="tag-label">Teams:</span>
            {teams.map((team) => (
              <a class="team" href={url(`charts/team/${team.abbr}`)} title={team.name}>
                <img src={url(`logos/${team.abbr}.png`)} alt={team.name} width="24" height="24" />
                <span class="count num">({team.count})</span>
              </a>
            ))}
          </nav>
        )}
        <ChartList charts={page.data} />
        {(page.url.prev || page.url.next) && (
          <nav class="pager" aria-label="Chart pages">
            {page.url.prev && <a href={page.url.prev}>Newer charts</a>}
            <span class="num">
              Page {page.currentPage} of {page.lastPage}
            </span>
            {page.url.next && <a href={page.url.next}>Older charts</a>}
          </nav>
        )}
      </>
    )
  }
</BaseLayout>

<style>
  .tag-bar,
  .pager {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }

  .tag-bar {
    margin-bottom: var(--space-3);
  }

  .team {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    text-decoration: none;
  }

  .team img {
    display: block;
    width: 24px;
    height: 24px;
  }

  .tag-bar:has(.team) {
    align-items: center;
    gap: var(--space-2);
  }

  .tag-label,
  .count {
    color: var(--text-dim);
  }

  .pager {
    margin-top: var(--space-3);
  }

  .placeholder-note {
    color: var(--text-dim);
  }
</style>
