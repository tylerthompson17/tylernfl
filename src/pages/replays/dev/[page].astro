---
/**
 * The whole highlights collection with picks and "Copy picked keys", for
 * choosing which plays get a replay. Dev only: getStaticPaths returns this
 * page under `astro dev` and nothing in a build, so it never ships and
 * nothing links to it. Open /replays/dev/catalog/ on the dev server.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Panel from '../../../components/Panel.astro';
import HighlightsTable from '../../../components/replays/HighlightsTable.astro';
import type { ReplayIndexData } from '../../../data/types';
import indexData from '../../../data/replays/index.json';
import { builtKeys } from '../../../utils/replays';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { page: 'catalog' } }] : [];
}

const built = builtKeys();
const plays = (indexData as ReplayIndexData).plays;
---

<BaseLayout title="Highlights catalog (dev)" rail={false}>
  <h1 class="page-title">Highlights catalog</h1>
  <p class="page-intro">
    Dev only, not in the build. Every play in the Next Gen Stats highlights collection; {built.size} of {plays.length} have a
    replay. Pick plays, copy their keys, and build scenes with <code>python pipelines/replays.py KEY ...</code>.
  </p>
  <Panel title="Highlights">
    <HighlightsTable plays={plays} built={built} picks />
  </Panel>
</BaseLayout>
