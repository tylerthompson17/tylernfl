---
/**
 * Retro Replays: every play in the Next Gen Stats highlights collection
 * (replays/index.json, pipelines/replays.py --index), with a link to its
 * replay where one has been built (replays/plays/). Facts only; nothing is
 * fetched. The script (src/lib/replays/catalog.ts) adds the filters,
 * sorting and picks. Its styles are global under .catalog: scoped styles
 * would stamp an attribute on each of the table's 5,000 or so elements.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Panel from '../../components/Panel.astro';
import type { ReplayIndexData, ReplayIndexEntry, Team } from '../../data/types';
import teamsData from '../../data/teams.json';
import indexData from '../../data/replays/index.json';
import { url } from '../../utils/url';
import { swingOf, TYPE_LABELS, typeLabel } from '../../lib/replays/catalog';

const plays = (indexData as ReplayIndexData).plays;
const built = new Set(
  Object.keys(import.meta.glob('../../data/replays/plays/*.json')).map((path) => path.split('/').pop()!.replace(/\.json$/, '')),
);
const teams = teamsData as Team[];
const known = new Map(teams.map((t) => [t.abbr, t.name]));
// Retired abbreviations: their own name in the filter, today's franchise for the link.
const RETIRED: Record<string, { name: string; now: string }> = {
  OAK: { name: 'Oakland Raiders', now: 'LV' },
  SD: { name: 'San Diego Chargers', now: 'LAC' },
  STL: { name: 'St. Louis Rams', now: 'LAR' },
};
const teamHref = (abbr: string) => {
  const now = RETIRED[abbr]?.now ?? abbr;
  return known.has(now) ? url(`teams/${now}`) : null;
};
const teamName = (abbr: string) => known.get(abbr) ?? RETIRED[abbr]?.name ?? abbr;
const teamOptions = [...new Set(plays.flatMap((p) => [p.away, p.home]).filter((t): t is string => !!t))].sort((a, b) =>
  teamName(a).localeCompare(teamName(b)),
);
const typeCounts = new Map<string, number>();
for (const p of plays) typeCounts.set(p.type, (typeCounts.get(p.type) ?? 0) + 1);
const types = Object.keys(TYPE_LABELS).filter((t) => typeCounts.has(t));

const ORDINAL = ['1st', '2nd', '3rd', '4th'];
function situation(p: ReplayIndexEntry): string {
  const when = p.quarter ? `${p.quarter >= 5 ? 'OT' : `Q${p.quarter}`}${p.clock ? ` ${p.clock.replace(/^0(?=\d:)/, '')}` : ''}` : '';
  const what =
    p.type === 'kickoff' ? 'kickoff' : p.down === null ? (p.type === 'two_point_conversion' ? 'two point try' : '') : `${ORDINAL[p.down - 1]} and ${p.yardsToGo}`;
  return [when, what].filter(Boolean).join(', ');
}
function dateText(date: string | null): string {
  if (!date) return '';
  const [y, m, d] = date.split('-').map(Number);
  return new Date(Date.UTC(y!, m! - 1, d!)).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}
function swingText(p: ReplayIndexEntry): string {
  const s = swingOf(p.wpBefore, p.wpAfter);
  return s === null ? '' : `${s >= 0 ? '+' : ''}${s.toFixed(1)}`;
}
// Biggest swing either way first, as the script sorts it; plays without one last.
const rows = [...plays].sort((a, b) => {
  const sa = swingOf(a.wpBefore, a.wpAfter), sb = swingOf(b.wpBefore, b.wpAfter);
  if (sa === null || sb === null) return sa === sb ? 0 : sa === null ? 1 : -1;
  return Math.abs(sb) - Math.abs(sa);
});
const NGS = 'https://github.com/asonty/ngs_highlights';
---

<BaseLayout
  title="Retro Replays"
  description="Famous NFL plays from Next Gen Stats tracking, redrawn as pixel art replays."
>
  <h1 class="page-title">Retro Replays</h1>
  <p class="page-intro">
    Famous plays from the 2017 to 2019 seasons, redrawn as pixel art from Next Gen Stats player tracking. Every play in
    the highlights collection is listed; {built.size} {built.size === 1 ? 'has' : 'have'} a replay so far.
  </p>

  <Panel title="Highlights">
    <div class="catalog" data-catalog>
      <div class="controls" data-controls hidden>
        <div class="row">
          <label>
            Team
            <select data-team>
              <option value="">All teams</option>
              {teamOptions.map((t) => <option value={t}>{teamName(t)}</option>)}
            </select>
          </label>
          <label class="check">
            <input type="checkbox" data-picked-only />
            Picked only
          </label>
        </div>
        <div class="chips" role="group" aria-label="Play type">
          <button type="button" data-type="" aria-pressed="true">All <span class="count">{plays.length}</span></button>
          {
            types.map((t) => (
              <button type="button" data-type={t} aria-pressed="false">
                {typeLabel(t)} <span class="count">{typeCounts.get(t)}</span>
              </button>
            ))
          }
        </div>
        <div class="row picks">
          <span class="num" data-pick-count>0 picked</span>
          <button type="button" class="action" data-copy disabled>Copy picked keys</button>
          <button type="button" class="action" data-clear disabled>Clear picks</button>
          <span class="dim" data-copy-status aria-live="polite"></span>
        </div>
      </div>
      <p class="status" data-status aria-live="polite">{plays.length} plays.</p>
      <p class="visually-hidden" aria-live="polite" data-sort-status></p>
      <div class="stat-table-scroll" tabindex="0">
        <table class="stat-table">
          <caption class="visually-hidden">Next Gen Stats highlight plays, biggest win probability swing first</caption>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Pick</span></th>
              <th scope="col" data-sort="date">Date</th>
              <th scope="col">Game</th>
              <th scope="col" data-sort="type">Type</th>
              <th scope="col">Situation</th>
              <th scope="col">Play</th>
              <th scope="col" class="number" data-sort="swing" aria-sort="descending" title="Points of the offense's win probability gained or lost on the play (nflfastR)">WP swing</th>
              <th scope="col">Replay</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((p) => {
                const swing = swingOf(p.wpBefore, p.wpAfter);
                return (
                  <tr
                    data-key={p.key}
                    data-date={p.date ?? ''}
                    data-teams={[p.away, p.home].filter(Boolean).join(' ')}
                    data-play-type={p.type}
                    data-swing={swing ?? undefined}
                  >
                    <td>
                      <input type="checkbox" data-pick value={p.key} disabled aria-labelledby={`play-${p.key}`} />
                    </td>
                    <td class="num">{dateText(p.date)}</td>
                    <td>
                      {p.away && p.home ? (
                        <>
                          {teamHref(p.away) ? <a href={teamHref(p.away)!}>{p.away}</a> : p.away} at{' '}
                          {teamHref(p.home) ? <a href={teamHref(p.home)!}>{p.home}</a> : p.home}
                        </>
                      ) : (
                        <span class="dim">Pro Bowl</span>
                      )}
                    </td>
                    <td>{typeLabel(p.type)}</td>
                    <td>{situation(p)}</td>
                    <td class="play" id={`play-${p.key}`}>
                      {p.touchdown && <span class="td">TD</span>}
                      {p.description}
                    </td>
                    <td
                      class="number"
                      title={swing === null ? undefined : `${p.offense} ${Math.round(p.wpBefore! * 100)}% to ${Math.round(p.wpAfter! * 100)}%`}
                    >
                      {swingText(p)}
                    </td>
                    <td>{built.has(p.key) ? <a href={url(`replays/${p.key}`)}>Watch</a> : <span class="dim">Not yet</span>}</td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
      <p class="source">
        Plays: NFL Next Gen Stats highlights, collected in <a href={NGS}>asonty/ngs_highlights</a>. Teams, descriptions
        and win probability: nflverse play-by-play (nflfastR's model). WP swing is the offense's (on kicks, the receiving
        team's), in points. Picks stay in this browser.
      </p>
    </div>
  </Panel>
</BaseLayout>

<script>
  import { initCatalog } from '../../lib/replays/catalog';
  const root = document.querySelector<HTMLElement>('[data-catalog]');
  if (root) initCatalog(root);
</script>

<style is:global>
  .catalog .controls .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .catalog label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
  }

  .catalog .check {
    font-weight: 400;
  }

  .catalog select {
    font: inherit;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--rule);
    background: var(--panel);
    color: var(--text);
  }

  .catalog .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-bottom: var(--space-2);
  }

  .catalog .chips button,
  .catalog .action {
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--rule);
    background: var(--panel);
  }

  .catalog .chips button[aria-pressed='true'] {
    background: var(--header);
    border-color: var(--header);
    color: var(--header-text);
    font-weight: 700;
  }

  .catalog .action:disabled {
    color: var(--text-dim);
    cursor: default;
  }

  .catalog .count {
    opacity: 0.75;
    font-variant-numeric: tabular-nums;
  }

  .catalog .status,
  .catalog .dim {
    color: var(--text-dim);
  }

  .catalog .status {
    margin-bottom: var(--space-2);
  }

  .catalog .play {
    white-space: normal;
    min-width: 32ch;
  }

  .catalog .td {
    display: inline-block;
    margin-right: var(--space-1);
    padding: 0 3px;
    background: var(--highlight);
    font-weight: 700;
    font-size: 10px;
  }

  .catalog tr[hidden] {
    display: none;
  }

  .catalog .source {
    margin-top: var(--space-2);
    color: var(--text-dim);
    font-size: 12px;
    max-width: 80ch;
  }

  /* Sort buttons read as header text; the arrow marks the sorted column. */
  .catalog .sort-button {
    font-weight: 700;
    padding: 0;
    width: 100%;
    text-align: inherit;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 2px;
  }

  .catalog th[aria-sort='descending'] .sort-button::after {
    content: ' \25BC';
    font-size: 9px;
  }

  .catalog th[aria-sort='ascending'] .sort-button::after {
    content: ' \25B2';
    font-size: 9px;
  }
</style>
