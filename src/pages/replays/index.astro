---
/**
 * Retro Replays: Tyler's featured replays (replays/featured.json, in his
 * order), and a link to every replay at /replays/all/, a page of its own
 * so this one stays light. A featured play whose replay failed its checks
 * is left out (the deploy's job summary warns). The scenes and index are
 * generated (pipelines/replays.py --all), so this reads them only if present.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Panel from '../../components/Panel.astro';
import HighlightsTable from '../../components/replays/HighlightsTable.astro';
import { builtKeys, featuredKeys, replayIndex } from '../../utils/replays';
import { url } from '../../utils/url';

const built = builtKeys();
const byKey = new Map(replayIndex().map((p) => [p.key, p]));
const featured = featuredKeys(built).flatMap((key) => byKey.get(key) ?? []);
---

<BaseLayout
  title="Retro Replays"
  description="Famous NFL plays from Next Gen Stats tracking, redrawn as pixel art replays."
>
  <h1 class="page-title">Retro Replays</h1>
  <p class="page-intro">
    Famous plays from the 2017 to 2019 seasons, redrawn as pixel art from Next Gen Stats player tracking. Pick a play
    to watch it.
  </p>
  <Panel title="Featured">
    {featured.length > 0 ? <HighlightsTable plays={featured} built={built} ordered /> : <p class="stat-table-empty">No replays yet.</p>}
  </Panel>
  {
    built.size > 0 && (
      <p class="browse">
        <a href={url('replays/all')}>Browse all {built.size} replays</a>, by team and play type.
      </p>
    )
  }
</BaseLayout>

<style>
  .browse {
    margin-top: var(--space-3);
  }
</style>
