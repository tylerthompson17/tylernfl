---
/**
 * Retro Replays: the plays that have a replay (replays/plays/), from the
 * highlights index (replays/index.json). The full collection, for picking
 * which to build next, is the dev-only catalog at /replays/dev/catalog/.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Panel from '../../components/Panel.astro';
import HighlightsTable from '../../components/replays/HighlightsTable.astro';
import type { ReplayIndexData } from '../../data/types';
import indexData from '../../data/replays/index.json';
import { builtKeys } from '../../utils/replays';

const built = builtKeys();
const plays = (indexData as ReplayIndexData).plays.filter((p) => built.has(p.key));
---

<BaseLayout
  title="Retro Replays"
  description="Famous NFL plays from Next Gen Stats tracking, redrawn as pixel art replays."
>
  <h1 class="page-title">Retro Replays</h1>
  <p class="page-intro">
    Famous plays from the 2017 to 2019 seasons, redrawn as pixel art from Next Gen Stats player tracking. Pick a play
    to watch it.
  </p>
  <Panel title="Replays">
    {plays.length > 0 ? <HighlightsTable plays={plays} built={built} /> : <p class="stat-table-empty">No replays yet.</p>}
  </Panel>
</BaseLayout>
