---
import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/Panel.astro';
import StatTable from '../components/StatTable.astro';
import FieldStrip from '../components/FieldStrip.astro';
import { url } from '../utils/url';
import { getArticles } from '../utils/articles';
import leadersData from '../data/leaders.json';
import { headlineItems, statusSummary, transactions } from '../utils/transactions';
import type { LeadersData } from '../data/types';

const leaders = leadersData as LeadersData;
const receiving = leaders.categories.find((c) => c.key === 'rec_yds');

const latest = (await getArticles())[0];

// Game statuses and real moves, starters first; practice squad churn and
// practice reports stay on the full wire.
const headlines = headlineItems(8);
const injurySummary = statusSummary(transactions.injuries);
const headlineColumns = [
  { key: 'team', label: 'Team', kind: 'team' as const },
  { key: 'player', label: 'Player', kind: 'player' as const, slugKey: 'slug' },
  { key: 'news', label: 'News' },
];

const leaderColumns = [
  { key: 'rank', label: 'Rk', kind: 'number' as const },
  { key: 'player', label: 'Player', kind: 'player' as const },
  { key: 'team', label: 'Team', kind: 'team' as const },
  { key: 'value', label: receiving?.valueLabel ?? 'Yds', kind: 'number' as const },
];
---

<BaseLayout title="Home">
  <h1 class="visually-hidden">Tyler NFL home</h1>
  <div class="content-grid home-grid">
    <Panel title="4th down calculator" class="lead">
      <FieldStrip ballOn={55} lineToGain={57} label="4th & 2 at MIN 45" />
      <p class="lead-copy">
        Go or kick? Every 4th down comes down to two win probabilities. The calculator will grade
        any situation you set, down to the timeout count.
      </p>
      <p><a href={url('tools/4th-down')}>Open the calculator</a></p>
    </Panel>
    <Panel title="Receiving yards leaders">
      {
        receiving ? (
          <StatTable
            columns={leaderColumns}
            rows={receiving.rows}
            caption="Receiving yards leaders"
            emptyText="No games played yet. Leaders appear after week 1."
          />
        ) : (
          <p class="placeholder-note">No games played yet. Leaders appear after week 1.</p>
        )
      }
      <p class="table-foot">
        Through week {leaders.throughWeek}.{' '}
        <a href={url(receiving ? `stats/${receiving.board}` : 'stats')}>Full receiving leaderboard</a>
      </p>
    </Panel>
    <Panel title="Transactions and injuries">
      {
        transactions.week === null ? (
          <p class="placeholder-note">
            Offseason. Roster moves and injury reports return in week 1.
          </p>
        ) : (
          <>
            <StatTable
              columns={headlineColumns}
              rows={headlines.items}
              caption="Top transactions and game statuses"
              emptyText="No game statuses or roster moves yet this week."
            />
            <p class="table-foot">
              Starters first. Week {transactions.week} game statuses:{' '}
              {injurySummary ?? 'none yet'}. {headlines.rest} more on the{' '}
              <a href={url('transactions')}>full wire</a>, filterable by team and type.
            </p>
          </>
        )
      }
    </Panel>
    <Panel title="Latest article">
      {
        latest ? (
          <>
            <h3 class="article-title">
              <a href={url(`articles/${latest.id}`)}>{latest.data.title}</a>
            </h3>
            <p class="article-desc">{latest.data.description}</p>
          </>
        ) : (
          <p class="placeholder-note">No articles yet.</p>
        )
      }
    </Panel>
  </div>
</BaseLayout>

<style>
  .home-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .home-grid > :global(.lead) {
    grid-column: 1 / -1;
  }

  .lead-copy {
    margin-top: var(--space-4);
    max-width: 60ch;
  }

  .lead-copy + p {
    margin-top: var(--space-2);
  }

  .table-foot {
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px dotted var(--rule-soft);
    color: var(--text-dim);
    font-size: 12px;
  }

  .article-title {
    font-size: 16px;
  }

  .article-desc {
    margin-top: var(--space-1);
    color: var(--text-dim);
  }

  @media (max-width: 900px) {
    .home-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
