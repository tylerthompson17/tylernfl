---
/**
 * The home page: two columns, main 2 to sidebar 1, chosen for the moment
 * the site was built in (homeState in src/lib/home/state.ts):
 *
 * - live (a game in its window): live 4th downs, the week's questionable
 *   calls, the chart | game statuses, the daily game, the article, playoff
 *   picture, archive.
 * - recap: the best game's chart, results, the week's calls, notable
 *   performances, transactions | article, coach grades, daily game,
 *   playoff picture, draft, archive. On a quiet recap (no kickoff today,
 *   Tuesday) the Retro Replay leads and transactions move to the sidebar.
 * - preview (quiet days): the Retro Replay, the week's calls, chart, results |
 *   daily game, article, transactions, coach grades, playoff picture, draft,
 *   on this day. The sidebar's transactions take up the slack here.
 * - offseason: articles, last season's coach grades, the chart | daily game,
 *   last season's final seeding, archive. (The draft order is empty then.)
 *
 * The two columns end within a row of each other: the main column ends
 * with a list whose row count (`Rows`, src/lib/home/rows.ts) follows the
 * chart above it (the EPA scatter is about 110px taller) and the width
 * (below 1100px the chart is shorter, so more rows). The counts were set
 * from measurements at 1440 and 1024 in every date state; the audit's
 * balance check (scripts/audit-pages.ts) reports how far apart the columns
 * end. On phones the columns flatten into one list in `--order`.
 */
import '../styles/home.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import PlayoffPicture from '../components/PlayoffPicture.astro';
import OnThisDay from '../components/OnThisDay.astro';
import HomeReplay from '../components/replays/HomeReplay.astro';
import HomeChart from '../components/home/HomeChart.astro';
import WeekResults from '../components/home/WeekResults.astro';
import HomeWire from '../components/home/HomeWire.astro';
import LiveFourthPanel from '../components/home/LiveFourthPanel.astro';
import QuestionableCalls from '../components/home/QuestionableCalls.astro';
import CoachGrades from '../components/home/CoachGrades.astro';
import DailyGame from '../components/home/DailyGame.astro';
import DraftTop from '../components/home/DraftTop.astro';
import NotablePanel from '../components/home/NotablePanel.astro';
import LatestArticles from '../components/home/LatestArticles.astro';
import { homeData, tallChart } from '../utils/home';
import { homeReplays } from '../utils/replays';
import type { Rows } from '../lib/home/rows';

const { state, quiet } = homeData;
const tall = await tallChart();
const replays = await homeReplays();

// Short lists on phones: one column, nothing to balance.
const PHONE = 8;
const calls = (wide: number, mid = wide): Rows => ({ wide, mid, phone: 3 });
const list = (wide: number, mid: number): Rows => ({ wide, mid, phone: Math.min(wide, PHONE) });
---

<BaseLayout title="Home" rail={false}>
  <h1 class="visually-hidden">Tyler NFL home</h1>
  <div class="home" data-home={state}>
    {
      state === 'live' && (
        <>
          <div class="home-col" data-balance="main">
            <div style="--order: 1"><LiveFourthPanel /></div>
            <div style="--order: 2"><QuestionableCalls rows={calls(8, 10)} /></div>
            <div style="--order: 6"><HomeChart /></div>
          </div>
          <div class="home-col" data-balance="side">
            <div style="--order: 3"><HomeWire title="Game statuses" rows={list(8, 8)} /></div>
            <div style="--order: 4"><DailyGame /></div>
            <div style="--order: 5"><LatestArticles limit={2} /></div>
            <div style="--order: 7"><PlayoffPicture /></div>
            {replays.length > 0 && <div style="--order: 8"><HomeReplay replays={replays} /></div>}
            <div style="--order: 9"><OnThisDay /></div>
          </div>
        </>
      )
    }
    {
      state === 'recap' && !(quiet && replays.length > 0) && (
        <>
          <div class="home-col" data-balance="main">
            <div style="--order: 1"><HomeChart /></div>
            <div style="--order: 2"><WeekResults /></div>
            <div style="--order: 3"><QuestionableCalls rows={calls(6)} /></div>
            <div style="--order: 7"><NotablePanel /></div>
            <div style="--order: 8"><HomeWire rows={list(tall ? 4 : 8, tall ? 9 : 12)} /></div>
          </div>
          <div class="home-col" data-balance="side">
            <div style="--order: 4"><LatestArticles limit={2} /></div>
            <div style="--order: 5"><CoachGrades rows={list(5, 5)} /></div>
            <div style="--order: 6"><DailyGame /></div>
            <div style="--order: 9"><PlayoffPicture /></div>
            <div style="--order: 10"><DraftTop rows={list(8, 8)} /></div>
            {replays.length > 0 && <div style="--order: 11"><HomeReplay replays={replays} /></div>}
            <div style="--order: 12"><OnThisDay /></div>
          </div>
        </>
      )
    }
    {
      state === 'recap' && quiet && replays.length > 0 && (
        <>
          <div class="home-col" data-balance="main">
            <div style="--order: 1"><HomeReplay replays={replays} /></div>
            <div style="--order: 2"><HomeChart /></div>
            <div style="--order: 3"><WeekResults /></div>
            <div style="--order: 4"><QuestionableCalls rows={calls(6)} /></div>
            <div style="--order: 9"><NotablePanel /></div>
          </div>
          <div class="home-col" data-balance="side">
            <div style="--order: 5"><LatestArticles limit={2} /></div>
            <div style="--order: 6"><CoachGrades rows={list(5, 5)} /></div>
            <div style="--order: 7"><DailyGame /></div>
            <div style="--order: 8"><HomeWire rows={list(tall ? 14 : 18, tall ? 13 : 16)} /></div>
            <div style="--order: 10"><PlayoffPicture /></div>
            <div style="--order: 11"><DraftTop rows={list(8, 8)} /></div>
            <div style="--order: 12"><OnThisDay /></div>
          </div>
        </>
      )
    }
    {
      state === 'preview' && (
        <>
          <div class="home-col" data-balance="main">
            {replays.length > 0 && <div style="--order: 1"><HomeReplay replays={replays} /></div>}
            <div style="--order: 2"><QuestionableCalls rows={calls(6)} /></div>
            <div style="--order: 6"><HomeChart /></div>
            <div style="--order: 7"><WeekResults /></div>
          </div>
          <div class="home-col" data-balance="side">
            <div style="--order: 3"><DailyGame /></div>
            <div style="--order: 4"><LatestArticles limit={2} /></div>
            <div style="--order: 5"><HomeWire rows={list(tall ? 12 : 8, tall ? 9 : 6)} /></div>
            <div style="--order: 8"><CoachGrades rows={list(5, 5)} /></div>
            <div style="--order: 9"><PlayoffPicture /></div>
            <div style="--order: 10"><DraftTop rows={list(8, 8)} /></div>
            <div style="--order: 11"><OnThisDay /></div>
          </div>
        </>
      )
    }
    {
      state === 'offseason' && (
        <>
          <div class="home-col" data-balance="main">
            <div style="--order: 1"><LatestArticles limit={3} /></div>
            <div style="--order: 3"><CoachGrades rows={list(11, 16)} /></div>
            <div style="--order: 4"><HomeChart /></div>
          </div>
          <div class="home-col" data-balance="side">
            <div style="--order: 2"><DailyGame /></div>
            <div style="--order: 5"><PlayoffPicture /></div>
            {replays.length > 0 && <div style="--order: 6"><HomeReplay replays={replays} /></div>}
            <div style="--order: 7"><OnThisDay /></div>
          </div>
        </>
      )
    }
  </div>
</BaseLayout>
