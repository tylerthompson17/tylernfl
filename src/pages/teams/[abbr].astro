---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Panel from '../../components/Panel.astro';
import TeamChip from '../../components/TeamChip.astro';
import StatTable from '../../components/StatTable.astro';
import teamsData from '../../data/teams.json';
import leadersData from '../../data/leaders.json';
import type { RosterPlayer, TeamsData, LeadersData } from '../../data/types';
import { groupPlayers, PRACTICE_SQUAD, rosterFor } from '../../utils/rosters';
import { formatExperience, formatHeight } from '../../utils/format';
import {
  isSmallSample,
  rankLabel,
  SMALL_SAMPLE_NOTE,
  teamLine,
  teamPanelRows,
  teamStats,
} from '../../utils/team-stats';
import { url } from '../../utils/url';
import {
  INJURY_NOTE,
  MOVES_NOTE,
  injuriesFor,
  injuryRows,
  moveRows,
  movesFor,
  transactions,
} from '../../utils/transactions';

export function getStaticPaths() {
  return (teamsData as TeamsData).map((team) => ({
    params: { abbr: team.abbr },
    props: { team },
  }));
}

const { team } = Astro.props;
const leaders = leadersData as LeadersData;

const roster = rosterFor(team.abbr);
const active = roster?.players.filter((p) => p.status !== PRACTICE_SQUAD) ?? [];
const practiceSquad = roster?.players.filter((p) => p.status === PRACTICE_SQUAD) ?? [];

function toRow(player: RosterPlayer) {
  return {
    number: player.number,
    name: player.name,
    slug: player.slug,
    position: player.position,
    status: player.statusLabel,
    height: formatHeight(player.heightInches),
    weight: player.weight,
    age: player.age,
    experience: formatExperience(player.experience),
    college: player.college,
  };
}

const rosterColumns = [
  { key: 'number', label: 'No.', kind: 'number' as const },
  { key: 'name', label: 'Player', kind: 'player' as const, slugKey: 'slug' },
  { key: 'position', label: 'Pos' },
  { key: 'status', label: 'Status' },
  { key: 'height', label: 'Ht', kind: 'number' as const },
  { key: 'weight', label: 'Wt', kind: 'number' as const },
  { key: 'age', label: 'Age', kind: 'number' as const },
  { key: 'experience', label: 'Exp', kind: 'number' as const },
  { key: 'college', label: 'College' },
];
// Everyone on the practice squad shares a status, so the column is dropped.
const practiceColumns = rosterColumns.filter((col) => col.key !== 'status');

const statLine = teamLine(team.abbr);
const statSmallSample = statLine !== undefined && isSmallSample(statLine.games);
const statColumns = [
  { key: 'measure', label: 'Measure' },
  { key: 'offValue', label: 'Value', kind: 'number' as const, group: 'Offense' },
  { key: 'offRank', label: rankLabel(statSmallSample), kind: 'number' as const, group: 'Offense' },
  { key: 'offSample', label: 'Sample', kind: 'number' as const, group: 'Offense' },
  { key: 'defValue', label: 'Value', kind: 'number' as const, group: 'Defense' },
  { key: 'defRank', label: rankLabel(statSmallSample), kind: 'number' as const, group: 'Defense' },
  { key: 'defSample', label: 'Sample', kind: 'number' as const, group: 'Defense' },
];

const teamMoves = moveRows(movesFor(team.abbr), team.abbr);
const teamInjuries = injuryRows(injuriesFor(team.abbr));
const teamMoveColumns = [
  { key: 'player', label: 'Player', kind: 'player' as const, slugKey: 'slug' },
  { key: 'position', label: 'Pos' },
  { key: 'move', label: 'Move' },
];
const teamInjuryColumns = [
  { key: 'player', label: 'Player', kind: 'player' as const, slugKey: 'slug' },
  { key: 'position', label: 'Pos' },
  { key: 'injury', label: 'Injury' },
  { key: 'practice', label: 'Practice' },
  { key: 'status', label: 'Game status' },
];

// This team's appearances in the current leaderboards.
const appearances = leaders.categories.flatMap((category) =>
  category.rows
    .filter((row) => row.team === team.abbr)
    .map((row) => ({
      category: category.label,
      player: row.player,
      rank: row.rank,
      value: row.value,
    }))
);

const appearanceColumns = [
  { key: 'category', label: 'Category' },
  { key: 'player', label: 'Player', kind: 'player' as const },
  { key: 'rank', label: 'Rk', kind: 'number' as const },
  { key: 'value', label: 'Value', kind: 'number' as const },
];
---

<BaseLayout title={team.name}>
  <h1 class="page-title team-heading">
    <TeamChip abbr={team.abbr} />
    {team.name}
  </h1>
  <div class="content-grid">
    <Panel title="Roster">
      {
        roster && active.length > 0 ? (
          <>
            {groupPlayers(roster, active).map((group) => (
              <section class="group">
                <h3 class="group-title">{group.label}</h3>
                <StatTable
                  columns={rosterColumns}
                  rows={group.players.map(toRow)}
                  caption={`${team.name} ${group.label.toLowerCase()} roster`}
                />
              </section>
            ))}
            <p class="table-foot">
              {active.length} players, from the week {roster.week} roster. Heights in feet and
              inches, Exp in completed seasons.
            </p>
          </>
        ) : (
          <p class="placeholder-note">
            No roster published yet. Rosters appear once nflverse posts them for the season.
          </p>
        )
      }
    </Panel>
    {
      practiceSquad.length > 0 && roster && (
        <Panel title="Practice squad">
          <StatTable
            columns={practiceColumns}
            rows={practiceSquad.map(toRow)}
            caption={`${team.name} practice squad`}
          />
        </Panel>
      )
    }
    <Panel title="Roster moves and injuries">
      {
        transactions.week === null ? (
          <p class="placeholder-note">
            Offseason. Roster moves and injury reports return in week 1.
          </p>
        ) : (
          <>
            <section class="group">
              <h3 class="group-title">
                {transactions.comparedToWeek === null
                  ? 'Roster moves'
                  : `Moves, week ${transactions.comparedToWeek} to week ${transactions.movesWeek}`}
              </h3>
              <StatTable
                columns={teamMoveColumns}
                rows={teamMoves}
                caption={`${team.name} roster moves`}
                emptyText={
                  transactions.comparedToWeek === null
                    ? 'No roster moves yet. Moves appear from week 2.'
                    : `No ${team.name} roster moves this week.`
                }
              />
              <p class="table-foot">{MOVES_NOTE}</p>
            </section>
            <section class="group">
              <h3 class="group-title">Week {transactions.week} injury report</h3>
              <StatTable
                columns={teamInjuryColumns}
                rows={teamInjuries}
                caption={`${team.name} week ${transactions.week} injury report`}
                emptyText={`No ${team.name} injury report yet for week ${transactions.week}.`}
              />
              <p class="table-foot">{INJURY_NOTE}</p>
            </section>
            <p class="table-foot">
              <a href={url('transactions')}>All moves and injuries</a>
            </p>
          </>
        )
      }
    </Panel>
    <Panel title={`${leaders.season} league leaderboard appearances`}>
      <StatTable
        columns={appearanceColumns}
        rows={appearances}
        caption={`${team.name} appearances in league leaderboards`}
        emptyText={`No ${team.name} players in the current leaderboards.`}
      />
    </Panel>
    <Panel title={`${teamStats.season} team stats`}>
      {
        statLine ? (
          <>
            <StatTable
              columns={statColumns}
              rows={teamPanelRows(statLine)}
              caption={`${team.name} offense and defense, with league ranks`}
            />
            <p class="table-foot">
              Through week {teamStats.throughWeek}, {statLine.games}{' '}
              {statLine.games === 1 ? 'game' : 'games'}. Ranks are out of 32; on defense the
              lowest value allowed ranks first. <a href={url('stats/teams')}>All team stats</a>
            </p>
            {statSmallSample && <p class="table-foot">{SMALL_SAMPLE_NOTE}</p>}
          </>
        ) : (
          <p class="placeholder-note">No games played yet. Team stats appear after week 1.</p>
        )
      }
    </Panel>
  </div>
</BaseLayout>

<style>
  .team-heading {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .group + .group {
    margin-top: var(--space-4);
  }

  .group-title {
    font-size: 15px;
    margin-bottom: var(--space-2);
  }

  .table-foot {
    margin-top: var(--space-3);
    color: var(--text-dim);
  }
</style>
