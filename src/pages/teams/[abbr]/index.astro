---
/** A team's overview: its division, season so far, stats, leaders and news. */
import TeamHub from '../../../components/team/TeamHub.astro';
import Panel from '../../../components/Panel.astro';
import StandingsTable from '../../../components/StandingsTable.astro';
import TeamSchedule from '../../../components/team/TeamSchedule.astro';
import TeamStatsPanel from '../../../components/team/TeamStatsPanel.astro';
import TeamLeaders from '../../../components/team/TeamLeaders.astro';
import TeamWire from '../../../components/team/TeamWire.astro';
import TeamOdds from '../../../components/team/TeamOdds.astro';
import teamsData from '../../../data/teams.json';
import type { Team, TeamsData } from '../../../data/types';
import { tieNotes } from '../../../lib/standings/ties';
import { standings } from '../../../utils/standings';
import { schedule } from '../../../utils/teams';
import { url } from '../../../utils/url';

export function getStaticPaths() {
  return (teamsData as TeamsData).map((team) => ({ params: { abbr: team.abbr }, props: { team } }));
}

const { team } = Astro.props as { team: Team };
const division = standings.teams.filter((t) => t.division === team.division).sort((a, b) => a.divisionRank - b.divisionRank);
const notes = tieNotes(division, 'divisionTiebreak');
---

<TeamHub team={team} tab="overview">
  <div class="overview">
    <Panel title={`${team.division} standings`} class="wide">
      <StandingsTable teams={division} caption={`${team.division} standings`} highlight={team.abbr} />
      <p class="table-foot">
        {notes.join(' ')}
        {standings.season < schedule.season ? `${standings.season} final standings. ` : `Through week ${standings.throughWeek}. `}
        <a href={url(team.conference === 'NFC' ? 'standings/nfc' : 'standings')}>{team.conference} standings</a>
      </p>
    </Panel>
    <div class="wide"><TeamOdds team={team} /></div>
    <Panel title={`${schedule.season} schedule and results`}>
      <TeamSchedule team={team} variant="compact" />
      <p class="table-foot"><a href={url(`teams/${team.abbr}/schedule`)}>Full schedule, with lines</a></p>
    </Panel>
    <TeamLeaders team={team} />
    <div class="wide"><TeamStatsPanel team={team} /></div>
    <div class="wide"><TeamWire team={team} limit={6} /></div>
  </div>
</TeamHub>

<style>
  .overview {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    align-items: start;
  }

  .overview > :global(.wide) {
    grid-column: 1 / -1;
  }

  .table-foot {
    margin-top: var(--space-2);
    color: var(--text-dim);
    font-size: 12px;
  }

  @media (max-width: 900px) {
    .overview {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
