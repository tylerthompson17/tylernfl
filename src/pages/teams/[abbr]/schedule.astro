---
/** A team's whole season: every game, result or kickoff, line and record. */
import TeamHub from '../../../components/team/TeamHub.astro';
import Panel from '../../../components/Panel.astro';
import TeamSchedule from '../../../components/team/TeamSchedule.astro';
import teamsData from '../../../data/teams.json';
import type { Team, TeamsData } from '../../../data/types';
import { schedule } from '../../../utils/teams';

export function getStaticPaths() {
  return (teamsData as TeamsData).map((team) => ({ params: { abbr: team.abbr }, props: { team } }));
}

const { team } = Astro.props as { team: Team };
---

<TeamHub team={team} tab="schedule">
  <Panel title={`${schedule.season} schedule`}>
    <TeamSchedule team={team} variant="full" />
    <p class="table-foot">
      Dates and kickoffs are in your time zone. The line is the betting favorite and by how much, from nflverse;
      lines appear about a week before a game and stay as they closed.
    </p>
  </Panel>
</TeamHub>

<style>
  .table-foot {
    margin-top: var(--space-2);
    color: var(--text-dim);
    font-size: 12px;
  }
</style>
