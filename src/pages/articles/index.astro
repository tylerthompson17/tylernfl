---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Panel from '../../components/Panel.astro';
import { url } from '../../utils/url';
import { getArticles } from '../../utils/articles';

const articles = await getArticles();

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
}
---

<BaseLayout title="Articles">
  <h1 class="page-title">Articles</h1>
  <div class="content-grid">
    {
      articles.length > 0 ? (
        articles.map((article) => (
          <Panel>
            <p class="date num">
              {formatDate(article.data.date)}
              {article.data.draft && <span class="draft">Draft</span>}
            </p>
            <h2 class="title">
              <a href={url(`articles/${article.id}`)}>{article.data.title}</a>
            </h2>
            <p class="desc">{article.data.description}</p>
          </Panel>
        ))
      ) : (
        <Panel>
          <p class="placeholder-note">No articles yet. The first one is being written.</p>
        </Panel>
      )
    }
  </div>
</BaseLayout>

<style>
  .date {
    color: var(--text-dim);
    font-size: 12px;
  }

  .draft {
    margin-left: var(--space-2);
    padding: 0 var(--space-1);
    background: var(--highlight);
    color: var(--text);
  }

  .title {
    font-size: 18px;
    margin-top: var(--space-1);
  }

  .desc {
    margin-top: var(--space-1);
    color: var(--text-dim);
    max-width: 70ch;
  }
</style>
