---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Panel from '../../components/Panel.astro';
import { getArticles, type Article } from '../../utils/articles';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { Content } = await render(article);

// Frontmatter dates are calendar dates; format in UTC so they don't
// shift a day earlier in timezones behind UTC.
const dateText = article.data.date.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={article.data.title} description={article.data.description}>
  <article class="content-grid">
    <Panel>
      <p class="date num">
        {dateText}
        {article.data.draft && <span class="draft">Draft, not published</span>}
      </p>
      <h1 class="article-heading">{article.data.title}</h1>
      <div class="prose">
        <Content />
      </div>
    </Panel>
  </article>
</BaseLayout>

<style>
  .date {
    color: var(--text-dim);
    font-size: 12px;
  }

  .draft {
    margin-left: var(--space-2);
    padding: 0 var(--space-1);
    background: var(--highlight);
    color: var(--text);
  }

  .article-heading {
    font-size: 24px;
    margin-top: var(--space-1);
    margin-bottom: var(--space-3);
    max-width: 26ch;
  }
</style>
