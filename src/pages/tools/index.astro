---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Panel from '../../components/Panel.astro';
import { url } from '../../utils/url';
---

<BaseLayout title="Tools">
  <h1 class="page-title">Tools</h1>
  <div class="content-grid">
    <Panel title="4th down calculator">
      <p>
        Set a game situation and see the win probability of going for it, kicking a field goal and
        punting, and after a touchdown, kicking the extra point against going for 2. The numbers are
        Ben Baldwin's nfl4th model, reproduced exactly.
      </p>
      <p class="open-link"><a href={url('fourth-down')}>Open the calculator</a></p>
    </Panel>
    <Panel title="4th down and 2-point decisions">
      <p>
        Every 4th down and try this season graded against nfl4th: head coaches ranked by the win
        probability their mistakes gave up, and the season's costliest calls.
      </p>
      <p class="open-link"><a href={url('decisions')}>See the coaches</a> <a href={url('decisions/worst')}>Worst decisions</a></p>
    </Panel>
    <Panel title="4th down daily">
      <p>
        Five real 4th downs from this season every day. Make each call, then see nfl4th's win
        probability for every option, what the coach did and what happened.
      </p>
      <p class="open-link"><a href={url('fourth-down/daily')}>Play today's game</a></p>
    </Panel>
  </div>
</BaseLayout>

<style>
  .open-link {
    margin-top: var(--space-3);
  }

  .open-link a + a {
    margin-left: var(--space-3);
  }
</style>
