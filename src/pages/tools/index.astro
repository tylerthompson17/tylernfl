---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Panel from '../../components/Panel.astro';
import { url } from '../../utils/url';
---

<BaseLayout title="Tools">
  <h1 class="page-title">Tools</h1>
  <div class="content-grid">
    <Panel title="4th down calculator">
      <p>
        Set a game situation and see the win probability for going for it against kicking, and the
        margin between them. In progress; the interface is up and the model is being trained.
      </p>
      <p class="open-link"><a href={url('tools/4th-down')}>Open the calculator</a></p>
    </Panel>
  </div>
</BaseLayout>

<style>
  .open-link {
    margin-top: var(--space-3);
  }
</style>
