---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Panel from '../../components/Panel.astro';
import TeamChip from '../../components/TeamChip.astro';
import GameLog from '../../components/GameLog.astro';
import { leaderboards } from '../../utils/leaderboards';
import { playerPages, type PlayerPage } from '../../utils/players';
import { seasonsFor } from '../../utils/player-stats';
import { formatExperience, formatHeight } from '../../utils/format';
import { url } from '../../utils/url';

export function getStaticPaths() {
  return [...playerPages.entries()].map(([slug, pages]) => ({
    params: { slug },
    props: { pages },
  }));
}

const { pages } = Astro.props as { pages: PlayerPage[] };
const season = leaderboards[0]?.season;
const throughWeek = leaderboards[0]?.throughWeek ?? 0;

// More than one player answers to this slug, so the page points at each of
// them rather than silently picking one.
const shared = pages.length > 1;
const page = pages[0]!;
const roster = page.roster;
const seasons = shared ? [] : seasonsFor(page.playerId);

const facts = roster
  ? [
      { label: 'Position', value: roster.position },
      { label: 'Number', value: roster.number === null ? null : `#${roster.number}` },
      { label: 'Status', value: roster.statusLabel },
      { label: 'Height', value: formatHeight(roster.heightInches) },
      { label: 'Weight', value: roster.weight === null ? null : `${roster.weight} lb` },
      { label: 'Age', value: roster.age === null ? null : String(roster.age) },
      { label: 'Experience', value: formatExperience(roster.experience) },
      { label: 'College', value: roster.college },
    ].filter((fact) => fact.value !== null)
  : [];
---

<BaseLayout title={page.name}>
  {
    shared ? (
      <>
        <h1 class="page-title">{page.name}</h1>
        <div class="content-grid">
          <Panel title="More than one player by this name">
            <ul class="choices">
              {pages.map((choice) => (
                <li>
                  <a href={url(`players/${choice.slug}`)}>{choice.name}</a>
                  <span class="choice-detail">
                    {choice.roster?.position}
                    <TeamChip abbr={choice.team} size="sm" />
                  </span>
                </li>
              ))}
            </ul>
          </Panel>
        </div>
      </>
    ) : (
      <>
        <h1 class="page-title player-heading">
          {page.name}
          <TeamChip abbr={page.team} size="sm" />
        </h1>
        <div class="content-grid">
          <Panel title="Player">
            {facts.length > 0 ? (
              <dl class="facts">
                {facts.map((fact) => (
                  <div class="fact">
                    <dt>{fact.label}</dt>
                    <dd class="num">{fact.value}</dd>
                  </div>
                ))}
              </dl>
            ) : (
              <p class="placeholder-note">
                Not on a current roster. Only leaderboard totals are on record.
              </p>
            )}
          </Panel>
          {seasons.length > 0 ? (
            seasons.map((data) => (
              <Panel title={`${season} ${data.board.label.toLowerCase()}`}>
                <GameLog data={data} team={page.team} />
              </Panel>
            ))
          ) : (
            <Panel title={`${season} season`}>
              <p class="placeholder-note">
                {throughWeek === 0
                  ? 'No games played yet this season.'
                  : `No passing, rushing, receiving, defensive or kicking stats through week ${throughWeek}.`}
              </p>
            </Panel>
          )}
          <p class="source">
            {season} regular season through week {throughWeek}, from nflverse weekly stats. Earlier
            seasons are not on the site yet.
          </p>
        </div>
      </>
    )
  }
</BaseLayout>

<style>
  .player-heading {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Boxes carry their own borders and share them through negative
     margins, so a short last row stretches to the edge instead of leaving
     a strip of the container color showing. */
  .facts {
    display: flex;
    flex-wrap: wrap;
  }

  .fact {
    flex: 1 1 110px;
    border: 1px solid var(--rule);
    margin: 0 -1px -1px 0;
    padding: var(--space-2);
  }

  .fact dt {
    color: var(--text-dim);
    font-size: 12px;
  }

  .fact dd {
    font-weight: 700;
  }

  .choices {
    list-style: none;
    padding: 0;
  }

  .choices li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: 360px;
  }

  .choices li + li {
    margin-top: var(--space-1);
    padding-top: var(--space-1);
    border-top: 1px dotted var(--rule-soft);
  }

  .source {
    color: var(--text-dim);
    font-size: 12px;
  }

  .choice-detail {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-dim);
  }
</style>
