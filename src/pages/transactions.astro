---
import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/Panel.astro';
import Wire from '../components/Wire.astro';
import {
  INJURY_NOTE,
  MOVES_NOTE,
  SNAPS_NOTE,
  statusSummary,
  transactions,
  wireItems,
} from '../utils/transactions';

const items = wireItems();
const summary = statusSummary(transactions.injuries);
const movesSpan =
  transactions.comparedToWeek === null
    ? 'Roster moves appear from week 2, comparing each week with the one before.'
    : `Roster moves from week ${transactions.comparedToWeek} to week ${transactions.movesWeek}.`;
---

<BaseLayout title="Transactions and injuries">
  <h1 class="page-title">Transactions and injuries</h1>
  {
    transactions.week === null ? (
      <div class="content-grid">
        <Panel title="Offseason">
          <p class="placeholder-note">
            Roster moves and injury reports return in week 1 of the regular season.
          </p>
        </Panel>
      </div>
    ) : (
      <>
        <p class="page-intro">
          {transactions.season} week {transactions.week}. {movesSpan} Game statuses so far:{' '}
          {summary ?? 'none yet'}.
        </p>
        <div class="content-grid">
          <Panel title="The wire">
            <Wire items={items} categories={transactions.categories} />
            <p class="table-foot">{SNAPS_NOTE}</p>
            <p class="table-foot">{MOVES_NOTE}</p>
            <p class="table-foot">{INJURY_NOTE}</p>
          </Panel>
        </div>
      </>
    )
  }
</BaseLayout>

<style>
  .page-intro {
    color: var(--text-dim);
    margin-bottom: var(--space-4);
  }

  .table-foot {
    margin-top: var(--space-2);
    color: var(--text-dim);
  }
</style>
