---
/**
 * Charts (Tyler's and the kept auto charts) as a grid of cards, newest first: the /charts gallery and
 * each tag's page. Each card links to the chart's own page. A chart about
 * particular teams shows their logos beside its title, since the ones drawn
 * inside the chart are too small to read at thumbnail size. The title
 * already names the teams, so the logos are decorative.
 */
import Panel from './Panel.astro';
import ChartFigure from './ChartFigure.astro';
import { formatChartDate, svgFor, type Chart } from '../utils/charts';
import { tagSlug } from '../lib/charts/collection';
import { url } from '../utils/url';

interface Props {
  charts: Chart[];
}

const { charts } = Astro.props;
---

<div class="chart-grid">
  {
    charts.map((chart) => (
      <Panel>
        <p class="meta num">
          {formatChartDate(chart.data.date)}, {chart.data.author}
          {chart.data.draft && <span class="draft">Draft</span>}
        </p>
        <div class="heading">
          {chart.data.teams.length > 0 && (
            <span class="logos">
              {chart.data.teams.map((team) => (
                <img src={url(`logos/${team}.png`)} alt="" width="24" height="24" loading="lazy" decoding="async" />
              ))}
            </span>
          )}
          <h2 class="title" id={`${chart.id}-title`}>
            <a href={url(`charts/${chart.id}`)}>{chart.data.title}</a>
          </h2>
        </div>
        <ChartFigure svg={svgFor(chart)} titleId={`${chart.id}-title`} note={chart.data.note} id={chart.id} size="thumb">
          {chart.data.tags.length > 0 && (
            <p class="tags">
              {chart.data.tags.map((tag) => (
                <a href={url(`charts/tag/${tagSlug(tag)}`)}>{tag}</a>
              ))}
            </p>
          )}
        </ChartFigure>
      </Panel>
    ))
  }
</div>

<style>
  .chart-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-3);
    align-items: start;
  }

  .meta {
    color: var(--text-dim);
    font-size: 12px;
  }

  .draft {
    margin-left: var(--space-2);
    padding: 0 var(--space-1);
    background: var(--highlight);
    color: var(--text);
  }

  .heading {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-1) 0 var(--space-2);
  }

  .logos {
    display: flex;
    flex: none;
    gap: var(--space-1);
  }

  .logos img {
    display: block;
    width: 24px;
    height: 24px;
  }

  .title {
    font-size: 16px;
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-size: 12px;
  }
</style>
