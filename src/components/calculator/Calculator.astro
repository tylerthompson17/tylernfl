---
/**
 * The 4th down calculator, either tab: the title, what the model is, the
 * tabs, the form and the result. The form is drawn with the defaults; the
 * script (src/lib/calculator/dom.ts) fills it from the URL, fetches the
 * model and recomputes as the inputs change. Nothing is computed at build
 * time.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Panel from '../Panel.astro';
import Tabs from '../Tabs.astro';
import { asOfContext } from '../../utils/as-of';
import { url } from '../../utils/url';
import { modelDownloadBytes, modelManifest as manifest } from '../../utils/fourth-down-model';
import { QUARTERS, ROOFS, defaults, seasonsUpTo, situationLine, yardline100Of, type CalculatorKind } from '../../lib/calculator/form';
import { fieldGoalKick, fieldStripHtml, type FieldState } from '../../lib/field/strip';

interface Props {
  kind: CalculatorKind;
}

const { kind } = Astro.props;
const season = asOfContext.season;
const d = defaults(kind, season);
const fourth = kind === 'fourth-down';
const team = fourth ? { us: 'Offense', them: 'Defense' } : { us: 'Scoring team', them: 'Opponent' };

// The default situation drawn before the script runs; the script redraws it as the inputs change.
const line = fourth ? situationLine(d) : null;
const ydsToGoal = yardline100Of(d.side, Number(d.yl));
const field: FieldState | null = line
  ? { yardline100: ydsToGoal, distance: Number(d.togo), label: line, kick: fieldGoalKick(ydsToGoal, manifest.kickDistanceOffset, manifest.maxFieldGoalDistance) }
  : null;

const downloadMb = (modelDownloadBytes / 1e6).toFixed(1);

const NFL4TH = 'https://github.com/nflverse/nfl4th';
const LICENSE = 'https://github.com/nflverse/nfl4th/blob/master/LICENSE';
const FASTR_LICENSE = 'https://github.com/nflverse/nflfastR/blob/master/LICENSE';
const METHODS = 'https://github.com/tylerthompson17/tylernfl/blob/main/docs/methods/fourth-down-model.md';
const tabs = [
  { key: 'fourth-down', label: '4th down', path: 'fourth-down' },
  { key: 'try', label: 'After a touchdown', path: 'fourth-down/try' },
];
const title = fourth ? '4th down calculator' : 'After a touchdown: kick or go for 2';
const description = fourth
  ? 'Set any 4th down situation and compare the win probability of going for it, kicking a field goal and punting, from nfl4th.'
  : 'After a touchdown, compare the win probability of kicking the extra point against going for 2, from nfl4th.';
---

<BaseLayout {title} {description}>
  <h1 class="page-title">4th down calculator</h1>
  <p class="page-intro">
    Ben Baldwin's <a href={NFL4TH}>nfl4th</a> model, reproduced exactly and run in your browser. It is not adjusted
    for the teams playing yet. <a href="#about-model">More on the model</a>. Test your calls against it in the{' '}
    <a href={url('fourth-down/daily')}>daily 4th down game</a>.
  </p>
  <Tabs label="Calculator decisions" tabs={tabs} current={kind} />

  <div
    class="calc"
    data-calculator={kind}
    data-season={season}
    data-kick-offset={manifest.kickDistanceOffset}
    data-kick-longest={manifest.maxFieldGoalDistance}
  >
    <Panel title={fourth ? 'Situation' : 'Game state after the touchdown'} class="calc-inputs">
      <form novalidate>
        {
          fourth && (
            <fieldset>
              <legend>Down and distance</legend>
              <div class="fields">
                <div class="field wide">
                  <span class="field-label" id="calc-ball-label">Ball on</span>
                  <div class="pair" role="group" aria-labelledby="calc-ball-label">
                    <select name="side" aria-label="Side of the field">
                      <option value="own" selected={d.side === 'own'}>Own</option>
                      <option value="opp" selected={d.side === 'opp'}>Opponent's</option>
                    </select>
                    <input
                      name="yl"
                      type="number"
                      inputmode="numeric"
                      min="1"
                      max="50"
                      value={d.yl}
                      aria-label="Yard line"
                      aria-describedby="calc-yl-error"
                    />
                  </div>
                  <p class="field-error" id="calc-yl-error" data-error-for="yl" hidden />
                </div>
                <div class="field">
                  <label for="calc-togo">Yards to go</label>
                  <input
                    id="calc-togo"
                    name="togo"
                    type="number"
                    inputmode="numeric"
                    min="1"
                    max="99"
                    value={d.togo}
                    aria-describedby="calc-togo-error"
                  />
                  <p class="field-error" id="calc-togo-error" data-error-for="togo" hidden />
                </div>
              </div>
              <div class="calc-field" data-calc-field set:html={field ? fieldStripHtml(field) : ''} />
              <p class="visually-hidden" data-calc-situation aria-live="polite">{field?.label}</p>
            </fieldset>
          )
        }

        <fieldset>
          <legend>Clock and score</legend>
          <div class="fields">
            <div class="field">
              <label for="calc-q">Quarter</label>
              <select id="calc-q" name="q">
                {QUARTERS.map((q) => <option value={q} selected={d.q === q}>{q === 'OT' ? 'Overtime' : q}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="calc-clock">Time left</label>
              <input
                id="calc-clock"
                name="clock"
                type="text"
                inputmode="numeric"
                autocomplete="off"
                value={d.clock}
                aria-describedby="calc-clock-help calc-clock-error"
              />
              <p class="help" id="calc-clock-help">In the quarter, as 10:00.</p>
              <p class="field-error" id="calc-clock-error" data-error-for="clock" hidden />
            </div>
            <div class="field">
              <label for="calc-pts">{team.us} score</label>
              <input id="calc-pts" name="pts" type="number" inputmode="numeric" min="0" value={d.pts} aria-describedby={fourth ? 'calc-pts-error' : 'calc-score-help calc-pts-error'} />
              <p class="field-error" id="calc-pts-error" data-error-for="pts" hidden />
            </div>
            <div class="field">
              <label for="calc-opp">{team.them} score</label>
              <input id="calc-opp" name="opp" type="number" inputmode="numeric" min="0" value={d.opp} aria-describedby={fourth ? 'calc-opp-error' : 'calc-score-help calc-opp-error'} />
              <p class="field-error" id="calc-opp-error" data-error-for="opp" hidden />
            </div>
            <div class="field">
              <label for="calc-to">{team.us} timeouts</label>
              <input id="calc-to" name="to" type="number" inputmode="numeric" min="0" max="3" value={d.to} aria-describedby="calc-to-error" />
              <p class="field-error" id="calc-to-error" data-error-for="to" hidden />
            </div>
            <div class="field">
              <label for="calc-oppto">{team.them} timeouts</label>
              <input id="calc-oppto" name="oppto" type="number" inputmode="numeric" min="0" max="3" value={d.oppto} aria-describedby="calc-oppto-error" />
              <p class="field-error" id="calc-oppto-error" data-error-for="oppto" hidden />
            </div>
          </div>
          {!fourth && <p class="help" id="calc-score-help">Scores include the touchdown's 6 points, before the try.</p>}
        </fieldset>

        <fieldset>
          <legend>Game</legend>
          <div class="fields">
            <div class="field">
              <label for="calc-home">{team.us} is</label>
              <select id="calc-home" name="home">
                <option value="off" selected={d.home === 'off'}>Home</option>
                <option value="def" selected={d.home === 'def'}>Away</option>
              </select>
            </div>
            <div class="field">
              <label for="calc-ko">Opening kickoff to</label>
              <select id="calc-ko" name="ko">
                <option value="off" selected={d.ko === 'off'}>{team.us}</option>
                <option value="def" selected={d.ko === 'def'}>{team.them}</option>
              </select>
            </div>
            <div class="field">
              <label for="calc-roof">Roof</label>
              <select id="calc-roof" name="roof">
                {ROOFS.map((r) => <option value={r.value} selected={d.roof === r.value}>{r.label}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="calc-season">Season</label>
              <select id="calc-season" name="season" aria-describedby="calc-season-error">
                {seasonsUpTo(season).map((s) => <option value={s} selected={d.season === String(s)}>{s}</option>)}
              </select>
              <p class="field-error" id="calc-season-error" data-error-for="season" hidden />
            </div>
            <div class="field">
              <label for="calc-spread">{team.us} spread</label>
              <input
                id="calc-spread"
                name="spread"
                type="number"
                inputmode="decimal"
                step="0.5"
                value={d.spread}
                aria-describedby="calc-spread-help calc-spread-error"
              />
              <p class="help" id="calc-spread-help">
                Pregame line as a sportsbook writes it: -3 if favored by 3, 3 if a 3 point underdog. Blank if unknown.
              </p>
              <p class="field-error" id="calc-spread-error" data-error-for="spread" hidden />
            </div>
            <div class="field">
              <label for="calc-total">Total</label>
              <input
                id="calc-total"
                name="total"
                type="number"
                inputmode="decimal"
                step="0.5"
                value={d.total}
                aria-describedby="calc-total-help calc-total-error"
              />
              <p class="help" id="calc-total-help">Pregame over/under, points by both teams. Blank if unknown.</p>
              <p class="field-error" id="calc-total-error" data-error-for="total" hidden />
            </div>
          </div>
        </fieldset>
      </form>
    </Panel>

    <Panel title={fourth ? 'Go, kick or punt' : 'Kick or go for 2'} class="calc-result">
      <div class="output" data-calc-output aria-busy="true">
        <noscript><p>The calculator runs in your browser and needs JavaScript.</p></noscript>
        <p class="loading">Loading the model, a one-time download of about {downloadMb} MB.</p>
      </div>
      <p class="visually-hidden" aria-live="polite" data-calc-announce></p>
      <p class="foot">
        Win probability is the {fourth ? 'offense' : 'scoring team'}'s chance to win the game after each choice.
        {
          fourth
            ? "nfl4th assumes a league-average kicker and doesn't know who's kicking. Temperature is not used."
            : "The extra point is nfl4th's league-average 33 yard kick."
        }
      </p>
    </Panel>

    <Panel title="About the model" class="calc-about" titleId="about-model">
      <div class="prose">
        <p>
          This is Ben Baldwin's <a href={NFL4TH}>nfl4th</a>, reproduced exactly: a port of its code (commit
          {manifest.source.nfl4thSha.slice(0, 7)}) and trained models that runs in your browser. On 3,907 test
          situations, 2,979 4th downs and 928 tries, its numbers match the reference port of nfl4th to within
          0.00000006 of win probability. <a href={METHODS}>How it was ported and checked</a>.
        </p>
        <p>
          It is not adjusted for the teams playing yet. Apart from the pregame spread and total, every team is
          treated alike. Every 4th down and try this season is <a href={url('decisions')}>graded against it</a>.
        </p>
        <p>
          nfl4th and the nflfastR models it builds on are by Ben Baldwin and Sebastian Carl, both released under
          the MIT license (<a href={LICENSE}>nfl4th's</a>, <a href={FASTR_LICENSE}>nflfastR's</a>).
        </p>
      </div>
    </Panel>
  </div>
</BaseLayout>

<script>
  import { initCalculator } from '../../lib/calculator/dom';
  initCalculator();
</script>

<style>
  .page-intro {
    color: var(--text-dim);
    margin-bottom: var(--space-3);
    max-width: 80ch;
  }

  .calc {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
  }

  .calc :global(.calc-about) {
    grid-column: 1 / -1;
  }

  @media (max-width: 900px) {
    .calc {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 var(--space-3);
    min-width: 0;
  }

  fieldset:last-child {
    margin-bottom: 0;
  }

  legend {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
    padding: 0;
    margin-bottom: var(--space-2);
    width: 100%;
    border-bottom: 1px dotted var(--rule-soft);
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: var(--space-2) var(--space-3);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .field.wide {
    grid-column: span 2;
  }

  label,
  .field-label {
    font-weight: 700;
  }

  input,
  select {
    font: inherit;
    color: var(--text);
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 2px var(--space-1);
    min-width: 0;
    width: 100%;
    font-variant-numeric: tabular-nums;
  }

  input[aria-invalid] {
    border-color: var(--loss);
    outline: 1px solid var(--loss);
  }

  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-1);
  }

  .help {
    color: var(--text-dim);
    font-size: 12px;
  }

  .field-error {
    color: var(--loss);
    font-size: 12px;
  }

  .calc-field {
    margin-top: var(--space-3);
  }

  .loading,
  .foot {
    color: var(--text-dim);
  }

  .foot {
    margin-top: var(--space-3);
  }

  .output :global(.calc-call) {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--header);
    color: var(--header-text);
  }

  .output :global(.calc-call-label) {
    font-size: 12px;
  }

  .output :global(.calc-call-value) {
    font-family: var(--font-heading);
    font-size: 22px;
  }

  .output :global(.calc-margin) {
    margin: var(--space-2) 0 var(--space-3);
  }

  .output :global(.calc-options) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: var(--space-2);
  }

  .output :global(.calc-option) {
    border: 1px solid var(--rule);
    padding: var(--space-2);
  }

  .output :global(.calc-option.best) {
    border-left: var(--mark-bar) solid var(--header);
  }

  .output :global(.calc-option-title) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: 16px;
  }

  .output :global(.calc-option-wp) {
    font-variant-numeric: tabular-nums;
  }

  .output :global(.calc-option-sub) {
    color: var(--text-dim);
    font-size: 12px;
    margin-bottom: var(--space-1);
  }

  .output :global(.calc-parts) {
    margin: 0;
    font-size: 12px;
  }

  .output :global(.calc-parts > div) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    padding: 2px 0;
    border-top: 1px dotted var(--rule-soft);
  }

  .output :global(.calc-parts dd) {
    margin: 0;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .output :global(.has-note) {
    text-decoration: underline dotted;
    cursor: help;
  }

  .output :global(.calc-skipped) {
    margin: var(--space-3) 0 0;
    padding-left: var(--space-4);
  }

  .output :global(.calc-note) {
    margin-top: var(--space-2);
    padding: var(--space-1) var(--space-2);
    background: var(--highlight-soft);
  }

  .output :global(.calc-unsupported) {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--rule);
  }
</style>
