---
/**
 * One key number as a boxed unit inside a panel: 1px border, label,
 * value, optional context line. `tone` colors the value for positive or
 * negative values only; yellow is never text.
 */
interface Props {
  label: string;
  value: string | number;
  sub?: string;
  tone?: 'neutral' | 'win' | 'loss';
}

const { label, value, sub, tone = 'neutral' } = Astro.props;
---

<div class="stat-card">
  <p class="label">{label}</p>
  <p class:list={['value', 'num', tone]}>{value}</p>
  {sub && <p class="sub">{sub}</p>}
</div>

<style>
  .stat-card {
    background: var(--panel);
    border: 1px solid var(--rule);
    padding: var(--space-2) var(--space-3);
    min-width: 0;
  }

  .label {
    color: var(--text-dim);
    font-size: 12px;
  }

  .value {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.1;
  }

  .value.win {
    color: var(--win);
  }

  .value.loss {
    color: var(--loss);
  }

  .sub {
    color: var(--text-dim);
    font-size: 12px;
  }
</style>
