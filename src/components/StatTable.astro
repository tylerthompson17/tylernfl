---
/**
 * Semantic data table as a boxed unit: 1px borders on every cell,
 * compact padding, 12px type, right-aligned tabular numbers. Team
 * columns render a TeamChip. Wide tables scroll horizontally inside
 * their panel, never the page.
 */
import TeamChip from './TeamChip.astro';
import { url } from '../utils/url';
import { playerSlug } from '../utils/slug';

export interface StatTableColumn {
  key: string;
  label: string;
  kind?: 'text' | 'number' | 'team' | 'player';
  /**
   * For a player column: the row key holding a written slug, as rosters
   * carry for players who share a name. Without it the slug is derived
   * from the name, which is right for data that has no slug of its own.
   */
  slugKey?: string;
}

interface Props {
  columns: StatTableColumn[];
  rows: Record<string, string | number | null>[];
  /** Screen reader description of the table */
  caption: string;
  /** Shown instead of the table when there are no rows */
  emptyText?: string;
}

const { columns, rows, caption, emptyText = 'No data yet.' } = Astro.props;
---

{rows.length === 0 && <p class="empty">{emptyText}</p>}
{rows.length > 0 && (
<div class="scroll" tabindex="0">
  <table>
    <caption class="visually-hidden">{caption}</caption>
    <thead>
      <tr>
        {columns.map((col) => <th scope="col" class={col.kind ?? 'text'}>{col.label}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            {columns.map((col) => (
              <td class={col.kind ?? 'text'}>
                {col.kind === 'team' && row[col.key] != null ? (
                  <TeamChip abbr={String(row[col.key])} size="sm" />
                ) : col.kind === 'player' && row[col.key] != null ? (
                  <a
                    href={url(
                      `players/${
                        (col.slugKey && row[col.slugKey]) ?? playerSlug(String(row[col.key]))
                      }`
                    )}
                  >
                    {row[col.key]}
                  </a>
                ) : (
                  row[col.key]
                )}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
)}

<style>
  .scroll {
    overflow-x: auto;
  }

  .empty {
    color: var(--text-dim);
  }

  table {
    width: 100%;
    font-size: 12px;
  }

  th,
  td {
    border: 1px solid var(--rule);
    padding: var(--cell-pad);
    text-align: left;
    white-space: nowrap;
  }

  th {
    background: var(--bg);
    font-weight: 700;
  }

  th.number,
  td.number {
    text-align: right;
  }

  /* Highlighted row on hover: yellow as background only */
  tbody tr:hover {
    background: var(--highlight);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
