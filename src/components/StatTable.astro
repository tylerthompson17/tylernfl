---
/**
 * Semantic data table as a boxed unit. Team columns render a TeamChip,
 * player columns a link. Styles are the shared .stat-table rules in
 * global.css.
 */
import TeamChip from './TeamChip.astro';
import { url } from '../utils/url';
import { playerSlug } from '../utils/slug';

export interface StatTableColumn {
  key: string;
  label: string;
  kind?: 'text' | 'number' | 'team' | 'player';
  /**
   * For a player column: the row key holding a written slug, as rosters
   * carry for players who share a name. Without it the slug is derived
   * from the name, which is right for data that has no slug of its own.
   */
  slugKey?: string;
  /**
   * Over-header shared by adjacent columns, e.g. "EPA/play" above a value
   * and a rank column. Columns without one span both header rows.
   */
  group?: string;
}

interface Props {
  columns: StatTableColumn[];
  rows: Record<string, string | number | null>[];
  /** Screen reader description of the table */
  caption: string;
  /** Shown instead of the table when there are no rows */
  emptyText?: string;
}

const { columns, rows, caption, emptyText = 'No data yet.' } = Astro.props;

// Adjacent columns with the same group share one over-header cell.
const runs: { group: string | undefined; columns: StatTableColumn[] }[] = [];
for (const col of columns) {
  const last = runs.at(-1);
  if (last && col.group !== undefined && last.group === col.group) last.columns.push(col);
  else runs.push({ group: col.group, columns: [col] });
}
const grouped = runs.some((run) => run.group !== undefined);
---

{rows.length === 0 && <p class="stat-table-empty">{emptyText}</p>}
{rows.length > 0 && (
<div class="stat-table-scroll" tabindex="0">
  <table class="stat-table">
    <caption class="visually-hidden">{caption}</caption>
    {grouped && runs.map((run) => <colgroup span={run.columns.length} />)}
    <thead>
      {
        grouped ? (
          <>
            <tr>
              {runs.map((run) =>
                run.group === undefined ? (
                  <th scope="col" rowspan="2" class={run.columns[0]!.kind ?? 'text'}>
                    {run.columns[0]!.label}
                  </th>
                ) : (
                  <th scope="colgroup" colspan={run.columns.length} class="group">
                    {run.group}
                  </th>
                )
              )}
            </tr>
            <tr>
              {runs
                .filter((run) => run.group !== undefined)
                .flatMap((run) => run.columns)
                .map((col) => <th scope="col" class={col.kind ?? 'text'}>{col.label}</th>)}
            </tr>
          </>
        ) : (
          <tr>
            {columns.map((col) => <th scope="col" class={col.kind ?? 'text'}>{col.label}</th>)}
          </tr>
        )
      }
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            {columns.map((col) => (
              <td class={col.kind ?? 'text'}>
                {col.kind === 'team' && row[col.key] != null ? (
                  <TeamChip abbr={String(row[col.key])} size="sm" />
                ) : col.kind === 'player' && row[col.key] != null ? (
                  <a
                    href={url(
                      `players/${
                        (col.slugKey && row[col.slugKey]) ?? playerSlug(String(row[col.key]))
                      }`
                    )}
                  >
                    {row[col.key]}
                  </a>
                ) : (
                  row[col.key]
                )}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
)}

