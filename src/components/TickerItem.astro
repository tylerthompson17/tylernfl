---
/**
 * One game slot in the score ticker. Upcoming games show kickoff time
 * with no scores; finals put the winner in bold, not color; live games
 * carry the quarter and clock on a yellow highlight background.
 *
 * The data attributes are hooks for src/lib/live-ticker/client.ts, which
 * localizes kickoff times and applies live scores in the browser. The
 * scoreboard page's boxes carry the same ones, so one poll updates both. A live
 * score that changes gets a brief first-down yellow highlight behind the
 * number, the site's one bit of motion besides the carousel itself. While
 * a game is pinned live, the last line says who scored last; it stays
 * hidden otherwise.
 *
 * A final's status links to its game page once it has one.
 *
 * An upcoming game shows the point spread in the empty score column beside
 * the favored team ("-3", or "PK" beside the home team), from schedule.json
 * (nflverse's lines). It is hidden from kickoff, when the live client sets
 * the slot's state and the score takes the column.
 *
 * Only a live game is ever marked here: when the scoreboard poll finds it
 * worth switching to (src/lib/live-ticker/mark.ts), the whole slot takes
 * a pale yellow tint and the word (Comeback, Close game, Shootout) shows
 * on a second line under the clock. Finished games' labels are shown on
 * /scores and /week, never in the ticker. From kickoff to the final the
 * line keeps room for the widest word, so the slot does not change size
 * when a mark comes or goes. It sits beside [data-detail], never inside
 * it, since the live client rewrites that element's text.
 */
import scheduleData from '../data/schedule.json';
import type { ScheduleData, TickerGame } from '../data/types';
import { tickerSpread } from '../lib/odds/spread';
import { LIVE_MARKS } from '../lib/live-ticker/mark';
import { gameHref } from '../utils/games';
import { url } from '../utils/url';

interface Props {
  game: TickerGame;
}

const { game } = Astro.props;

const decided = game.state === 'final' && game.awayScore != null && game.homeScore != null;
const awayWon = decided && game.awayScore! > game.homeScore!;
const homeWon = decided && game.homeScore! > game.awayScore!;
// A final with a game page links its status to it. Final stays final, so
// the live client only ever rewrites this link's text.
const href = game.state === 'final' ? gameHref(game.id) : null;
const spread =
  game.state === 'pre'
    ? tickerSpread((scheduleData as ScheduleData).games.find((g) => g.id === game.id)?.spreadLine)
    : null;
---

<li
  class="game"
  data-game
  data-state={game.state}
  data-espn-id={game.espnId ?? undefined}
  data-kickoff={game.kickoff ?? undefined}
>
  <span class="status">
    {
      href ? (
        <a class="detail" href={href} data-detail aria-label={`${game.detail}: ${game.away} at ${game.home}, game page`}>{game.detail}</a>
      ) : (
        <span class:list={['detail', { live: game.state === 'live' }]} data-detail>{game.detail}</span>
      )
    }
    <span class="mark">
      <span class="mark-room" aria-hidden="true">{LIVE_MARKS.map((word) => <span>{word}</span>)}</span>
      <span class="mark-text" data-live-mark-text></span>
    </span>
  </span>
  <span class:list={['line', { won: awayWon }]} data-side="away" data-team={game.away}>
    <a class="team" href={url(`teams/${game.away}`)}>{game.away}</a>
    {
      spread?.side === 'away' && (
        <span class="spread">
          <span aria-hidden="true">{spread.text}</span>
          <span class="visually-hidden">{spread.words}</span>
        </span>
      )
    }
    <span class="num" data-score>{game.awayScore ?? ''}</span>
  </span>
  <span class:list={['line', { won: homeWon }]} data-side="home" data-team={game.home}>
    <a class="team" href={url(`teams/${game.home}`)}>{game.home}</a>
    {
      spread?.side === 'home' && (
        <span class="spread">
          <span aria-hidden="true">{spread.text}</span>
          <span class="visually-hidden">{spread.words}</span>
        </span>
      )
    }
    <span class="num" data-score>{game.homeScore ?? ''}</span>
  </span>
  <span class="last-score" data-last-score hidden>
    <span class="visually-hidden">Last score: </span><span data-last-score-text></span>
  </span>
</li>

<style>
  /* Positioned so the slot is the containing block for its visually hidden
     "Last score:" label (position: absolute). Without it the label is
     placed against the page, outside the ticker's scrolling row, and a
     live game off the right of a phone's row stretched the page sideways. */
  .game {
    position: relative;
    display: grid;
    grid-template-areas:
      'detail away'
      'detail home'
      'last last';
    column-gap: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border-right: 1px solid var(--rule);
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.35;
  }

  /* A live game worth watching: the whole slot, background only. */
  .game[data-state='live'][data-mark] {
    background: var(--highlight-soft);
  }

  .status {
    grid-area: detail;
    align-self: center;
    display: flex;
    flex-direction: column;
    max-width: 72px;
    font-size: 12px;
  }

  .detail {
    color: var(--text-dim);
  }

  /* A final's link to its game page: blue and underlined, as every link is. */
  a.detail {
    color: var(--link);
  }

  /* The mark's line exists only while the game is live, and then always:
     the hidden stack of every word holds the widest one's room, and the
     visible word sits on top of it, so nothing moves when it changes. */
  /* Bold throughout, so the hidden room is as wide as the word shown. */
  .mark {
    display: none;
    font-weight: 700;
    color: var(--text);
  }

  .game[data-state='live'] .mark {
    display: grid;
  }

  .mark-room,
  .mark-text {
    grid-area: 1 / 1;
  }

  .mark-room {
    display: grid;
    visibility: hidden;
  }

  .mark-room > span {
    grid-area: 1 / 1;
    white-space: nowrap;
  }

  .mark-text {
    white-space: nowrap;
  }

  .detail.live {
    background: var(--highlight);
    color: var(--text);
    padding: 0 var(--space-1);
  }

  .line {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    min-width: 64px;
  }

  .line.won {
    font-weight: 700;
  }

  /* The spread, until kickoff. Dimmed, so it never reads as a score. */
  .spread {
    margin-left: auto;
    color: var(--text-dim);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .game:not([data-state='pre']) .spread {
    display: none;
  }

  /* Who scored last, under a pinned live game. Sized by the slot rather
     than the text (inline-size containment), cut with an ellipsis; the
     full play is in the tooltip and read in full by screen readers. */
  .last-score {
    grid-area: last;
    contain: inline-size;
    margin-top: 2px;
    padding-top: 2px;
    border-top: 1px dotted var(--rule-soft);
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .last-score[hidden] {
    display: none;
  }

  /* Room for the highlight without shifting the digits. */
  .num {
    padding: 0 var(--space-1);
    margin-right: calc(-1 * var(--space-1));
  }

  /* Yellow as a background only, fading out over a moment. The global
     reduced motion rule cuts it to nothing. */
  .num.score-changed {
    animation: score-changed 2s ease-out;
  }

  @keyframes score-changed {
    from {
      background: var(--highlight);
    }

    to {
      background: transparent;
    }
  }

  /* Scoreboard chrome: team links keep text color, underline on hover
     only. A deliberate exception to blue underlined links. */
  .team {
    color: inherit;
    text-decoration: none;
  }

  .team:hover {
    text-decoration: underline;
  }
</style>
