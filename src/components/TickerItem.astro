---
/**
 * One game slot in the score ticker. Upcoming games show kickoff time
 * with no scores; finals put the winner in bold, not color; live games
 * carry the quarter and clock on a yellow highlight background.
 */
import type { TickerGame } from '../data/types';
import { url } from '../utils/url';

interface Props {
  game: TickerGame;
}

const { game } = Astro.props;

const awayWon =
  game.state === 'final' && game.awayScore != null && game.homeScore != null
    ? game.awayScore > game.homeScore
    : null;
---

<li class="game">
  <span class:list={['detail', { live: game.state === 'live' }]}>{game.detail}</span>
  <span class:list={['line', { won: awayWon === true }]}>
    <a class="team" href={url(`teams/${game.away}`)}>{game.away}</a>
    {game.awayScore != null && <span class="num">{game.awayScore}</span>}
  </span>
  <span class:list={['line', { won: awayWon === false }]}>
    <a class="team" href={url(`teams/${game.home}`)}>{game.home}</a>
    {game.homeScore != null && <span class="num">{game.homeScore}</span>}
  </span>
</li>

<style>
  .game {
    display: grid;
    grid-template-areas:
      'detail away'
      'detail home';
    column-gap: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border-right: 1px solid var(--rule);
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.35;
  }

  .detail {
    grid-area: detail;
    align-self: center;
    color: var(--text-dim);
    font-size: 12px;
    max-width: 72px;
  }

  .detail.live {
    background: var(--highlight);
    color: var(--text);
    padding: 0 var(--space-1);
  }

  .line {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    min-width: 64px;
  }

  .line.won {
    font-weight: 700;
  }

  /* Scoreboard chrome: team links keep text color, underline on hover
     only. A deliberate exception to blue underlined links. */
  .team {
    color: inherit;
    text-decoration: none;
  }

  .team:hover {
    text-decoration: underline;
  }
</style>
