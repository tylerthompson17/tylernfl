---
/**
 * One game slot in the score ticker. Upcoming games show kickoff time
 * with no scores; finals put the winner in bold, not color; live games
 * carry the quarter and clock on a yellow highlight background.
 *
 * The data attributes are hooks for src/lib/live-ticker/client.ts, which
 * localizes kickoff times and applies live scores in the browser. A live
 * score that changes gets a brief first-down yellow highlight behind the
 * number, the site's one bit of motion besides the carousel itself. While
 * a game is pinned live, the last line says who scored last; it stays
 * hidden otherwise.
 */
import type { TickerGame } from '../data/types';
import { url } from '../utils/url';

interface Props {
  game: TickerGame;
}

const { game } = Astro.props;

const decided = game.state === 'final' && game.awayScore != null && game.homeScore != null;
const awayWon = decided && game.awayScore! > game.homeScore!;
const homeWon = decided && game.homeScore! > game.awayScore!;
---

<li
  class="game"
  data-state={game.state}
  data-espn-id={game.espnId ?? undefined}
  data-kickoff={game.kickoff ?? undefined}
>
  <span class:list={['detail', { live: game.state === 'live' }]} data-detail>{game.detail}</span>
  <span class:list={['line', { won: awayWon }]} data-side="away">
    <a class="team" href={url(`teams/${game.away}`)}>{game.away}</a>
    <span class="num" data-score>{game.awayScore ?? ''}</span>
  </span>
  <span class:list={['line', { won: homeWon }]} data-side="home">
    <a class="team" href={url(`teams/${game.home}`)}>{game.home}</a>
    <span class="num" data-score>{game.homeScore ?? ''}</span>
  </span>
  <span class="last-score" data-last-score hidden>
    <span class="visually-hidden">Last score: </span><span data-last-score-text></span>
  </span>
</li>

<style>
  .game {
    display: grid;
    grid-template-areas:
      'detail away'
      'detail home'
      'last last';
    column-gap: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border-right: 1px solid var(--rule);
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.35;
  }

  .detail {
    grid-area: detail;
    align-self: center;
    color: var(--text-dim);
    font-size: 12px;
    max-width: 72px;
  }

  .detail.live {
    background: var(--highlight);
    color: var(--text);
    padding: 0 var(--space-1);
  }

  .line {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    min-width: 64px;
  }

  .line.won {
    font-weight: 700;
  }

  /* Who scored last, under a pinned live game. Sized by the slot rather
     than the text (inline-size containment), cut with an ellipsis; the
     full play is in the tooltip and read in full by screen readers. */
  .last-score {
    grid-area: last;
    contain: inline-size;
    margin-top: 2px;
    padding-top: 2px;
    border-top: 1px dotted var(--rule-soft);
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .last-score[hidden] {
    display: none;
  }

  /* Room for the highlight without shifting the digits. */
  .num {
    padding: 0 var(--space-1);
    margin-right: calc(-1 * var(--space-1));
  }

  /* Yellow as a background only, fading out over a moment. The global
     reduced motion rule cuts it to nothing. */
  .num.score-changed {
    animation: score-changed 2s ease-out;
  }

  @keyframes score-changed {
    from {
      background: var(--highlight);
    }

    to {
      background: transparent;
    }
  }

  /* Scoreboard chrome: team links keep text color, underline on hover
     only. A deliberate exception to blue underlined links. */
  .team {
    color: inherit;
    text-decoration: none;
  }

  .team:hover {
    text-decoration: underline;
  }
</style>
