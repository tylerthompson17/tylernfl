---
/**
 * A chart placed inline, with its note underneath. Inline rather than an
 * <img> so the chart's text is drawn in the site's own fonts and its logos
 * load from the site (see pipelines/charts/style.py).
 *
 * The title is the parent's heading, found by `titleId`; the SVG is named
 * by it and described by the note, so a screen reader hears the chart as
 * one image with a takeaway.
 *
 * With hover data (from the pipeline's <slug>.hover.json), a full-size
 * chart can be read point by point: hover, drag, or the arrow keys
 * (src/lib/charts/hover-dom.ts). The data is written into the page, not
 * fetched. Thumbnails stay plain; they link to the full chart.
 *
 * A chart made elsewhere has finished images instead of an SVG, each with
 * its own alt text, stacked in order. A thumbnail shows only the first.
 *
 * `marks` lays linked points over a drawn chart (a game page's 4th downs
 * and tries on its win probability line): a second SVG with the chart's
 * own viewBox, so the marks scale and scroll with it, outside the chart's
 * role="img" so each is a link a screen reader can reach. Positions are
 * in viewBox units (toSvg in src/lib/charts/hover.ts).
 */
import type { ChartHover } from '../lib/charts/hover';

export interface ChartMark {
  /** viewBox units */
  x: number;
  y: number;
  href: string;
  label: string;
  /** A square for a try, a circle for a 4th down */
  shape: 'circle' | 'square';
  /** Drawn larger, filled in --loss, and ringed: the ring is the cue that does not rely on color */
  strong: boolean;
}
import { chartSvg, type ChartImage } from '../utils/charts';

interface Props {
  svg?: string;
  images?: ChartImage[];
  /** id of the heading that titles the chart */
  titleId: string;
  note: string;
  /** Unique on the page; used for the note's id */
  id: string;
  size?: 'full' | 'thumb';
  hover?: ChartHover | null;
  marks?: ChartMark[];
  /** Names the marks as a group, for screen readers */
  marksLabel?: string;
}

const { svg, images = [], titleId, note, id, size = 'full', hover, marks = [], marksLabel } = Astro.props;
// The chart's viewBox, for the marks layer; matplotlib writes "0 0 w h".
const viewBox = svg ? /viewBox="([\d.\s]+)"/.exec(svg)?.[1] : undefined;
const marked = size === 'full' && marks.length > 0 && viewBox;
const shown = size === 'thumb' ? images.slice(0, 1) : images;
const noteId = `${id}-note`;
const hintId = `${id}-hint`;
const readable = size === 'full' && hover && hover.points.length > 0;
// JSON in a script element: "<" escaped so no string in it can end the element.
const hoverJson = readable ? JSON.stringify(hover).replace(/</g, '\\u003c') : '';
---

<figure class:list={['chart', size]} data-chart-hover={readable ? '' : undefined}>
  {/* Focusable so the chart can be scrolled with the keyboard when it is
      wider than a phone screen, as the site's tables are, and read with
      the arrow keys when it has hover data. */}
  {svg && marked ? (
    <div class="frame" tabindex="0" aria-describedby={readable ? hintId : undefined}>
      <div class="canvas">
        <Fragment set:html={chartSvg(svg, titleId, noteId)} />
        <svg class="marks" viewBox={viewBox} role="group" aria-label={marksLabel}>
          {marks.map((m) => (
            <a href={m.href} aria-label={m.label} class:list={['mark', m.shape, { strong: m.strong }]}>
              <title>{m.label}</title>
              {/* A larger invisible target for pointer and touch, and the focus ring. */}
              <circle class="hit" cx={m.x} cy={m.y} r="15" />
              {m.strong &&
                (m.shape === 'circle' ? (
                  <circle class="ring" cx={m.x} cy={m.y} r="10" />
                ) : (
                  <rect class="ring" x={m.x - 9.5} y={m.y - 9.5} width="19" height="19" />
                ))}
              {m.shape === 'circle' ? (
                <circle class="dot" cx={m.x} cy={m.y} r={m.strong ? 6 : 4.5} />
              ) : (
                <rect class="dot" x={m.x - (m.strong ? 5.5 : 4)} y={m.y - (m.strong ? 5.5 : 4)} width={m.strong ? 11 : 8} height={m.strong ? 11 : 8} />
              )}
            </a>
          ))}
        </svg>
      </div>
    </div>
  ) : svg ? (
    <div
      class="frame"
      tabindex={size === 'full' ? 0 : undefined}
      aria-describedby={readable ? hintId : undefined}
      set:html={chartSvg(svg, titleId, noteId)}
    />
  ) : (
    shown.map((image) => (
      <div class="frame" tabindex={size === 'full' ? 0 : undefined}>
        <img src={image.src} width={image.width} height={image.height} alt={image.alt} loading={size === 'thumb' ? 'lazy' : undefined} decoding="async" />
      </div>
    ))
  )}
  {readable && <script type="application/json" data-chart-hover-data set:html={hoverJson} />}
  <figcaption>
    <p class="note" id={noteId}>{note}</p>
    {readable && (
      <p class="hint" id={hintId}>
        Hover or drag across the chart, or focus it and use the arrow keys, to read each point.
      </p>
    )}
    <slot />
  </figcaption>
</figure>

<script>
  import { initChartHover } from '../lib/charts/hover-dom';

  initChartHover();
</script>

<style>
  .frame {
    position: relative;
    border: 1px solid var(--rule);
  }

  .hint {
    margin-top: var(--space-1);
    color: var(--text-dim);
    font-size: 12px;
  }

  /* The hover readout, built by hover-dom.ts. Laid over the chart and
     never in the way of the pointer. Nothing animates. */
  .frame :global(.hover-layer) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .frame :global(.hover-layer[hidden]),
  .frame :global(.hover-guide[hidden]),
  .frame :global(.hover-dot[hidden]) {
    display: none;
  }

  .frame :global(.hover-guide) {
    position: absolute;
    width: 0;
    border-left: 1px solid var(--text-dim);
  }

  .frame :global(.hover-dot) {
    position: absolute;
    width: 11px;
    height: 11px;
    margin: -5.5px 0 0 -5.5px;
    /* A round data mark, like the chart's own; a panel-colored ring, not a
       shadow, keeps it clear of the line. */
    border-radius: 50%;
    border: 2px solid var(--panel);
    background: var(--header);
  }

  .frame :global(.hover-readout) {
    position: absolute;
    display: flex;
    flex-direction: column;
    width: max-content;
    max-width: 260px;
    padding: var(--space-1) var(--space-2);
    background: var(--panel);
    border: 1px solid var(--rule);
    font-size: 12px;
    line-height: 1.35;
  }

  .frame :global(.hover-readout strong) {
    font-family: var(--font-heading);
  }

  .frame :global(svg),
  .frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The chart and its marks layer, one box so they scroll together. */
  .canvas {
    position: relative;
  }

  .chart .frame svg.marks {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-width: 0;
    /* Only the marks take the pointer; the chart under them keeps its hover. */
    pointer-events: none;
    overflow: visible;
  }

  .marks .mark {
    pointer-events: auto;
    cursor: pointer;
  }

  .marks .mark .dot {
    fill: var(--panel);
    stroke: var(--header);
    stroke-width: 2;
  }

  .marks .mark.circle .dot {
    fill: var(--header);
    stroke: var(--panel);
    stroke-width: 1.5;
  }

  .marks .mark.strong .dot {
    fill: var(--loss);
    stroke: var(--panel);
    stroke-width: 1.5;
  }

  /* A questionable call's ring, so it reads without color too. */
  .marks .mark .ring {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.5;
  }

  .marks .mark:hover .dot,
  .marks .mark:focus-visible .dot {
    stroke: var(--link);
    stroke-width: 3;
  }

  .marks .mark .hit {
    fill: transparent;
    stroke: none;
  }

  /* The focus ring: around the target, blue on the white chart. */
  .marks .mark:focus {
    outline: none;
  }

  .marks .mark:focus-visible .hit {
    stroke: var(--link);
    stroke-width: 3;
  }

  .full .canvas {
    min-width: 600px;
  }

  .frame + .frame {
    margin-top: var(--space-2);
  }

  /* Chart text scales with the chart. Below 600px wide the labels would
     drop under 10px, so a full-size chart stops shrinking there and its
     frame scrolls sideways instead, like a wide table. Thumbnails keep
     shrinking: they are a preview, and link to the full chart. */
  .full .frame {
    overflow-x: auto;
  }

  .full .frame :global(svg),
  .full .frame img {
    min-width: 600px;
  }

  figcaption {
    margin-top: var(--space-2);
  }

  .note {
    max-width: 70ch;
  }

  .thumb .note {
    color: var(--text);
    font-size: 12px;
  }
</style>
