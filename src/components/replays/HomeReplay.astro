---
/**
 * The home page's Retro Replay: one of the featured replays at random on
 * each visit, picked in the browser (src/lib/replays/home.ts), which loads
 * that play's scene and the player only then. The page carries the short
 * list alone. The caller renders this only when the build has featured
 * replays.
 *
 * Two layouts, chosen by the panel's own width (a container query), so the
 * reserved height depends on nothing else and filling it shifts nothing:
 * from 760px, the field (at most 540px wide, 360px tall) and its controls
 * on the left, and the title, description, scoreline, speed and toggles,
 * links and "Another play" on the right, every one of fixed height; below
 * that, the title with "Another play", the field, the controls, speed and
 * toggles, and the links, with the description and scoreline left to the
 * replay page.
 */
import Panel from '../Panel.astro';
import type { FeaturedReplay } from '../../lib/replays/pick';
import { url } from '../../utils/url';

interface Props {
  replays: FeaturedReplay[];
}

const { replays } = Astro.props;
// "</script>" can never appear in JSON.stringify output once "<" is escaped.
const embedded = JSON.stringify(replays).replace(/</g, '\\u003c');
---

<Panel title="Retro Replay" flush>
  <div class="frame" data-home-replay>
    <div class="home-replay">
      <p class="replay-title" data-replay-title></p>
      <p class="replay-description" data-replay-description></p>
      <div class="scoreline" data-replay-scoreline></div>
      <div class="stage">
        <canvas class="replay-canvas" width="504" height="336" data-canvas role="img" aria-label="Pixel art replay drawn from player tracking"
        ></canvas>
        <div class="layer" aria-hidden="true">
          <p class="caption" data-caption hidden></p>
          <span class="tag" data-tag="speed" hidden></span>
          <span class="tag" data-tag="air" hidden></span>
          <span class="tag" data-tag="separation" hidden></span>
          <span class="tag" data-tag="carrier" hidden></span>
        </div>
        <p class="status" data-replay-status role="status">Loading the replay…</p>
        <noscript><p class="status">The replay needs JavaScript.</p></noscript>
      </div>
      <div class="controls">
        <button type="button" class="control primary" data-play disabled>Play</button>
        <button type="button" class="control" data-restart disabled>Restart</button>
        <input class="scrub" type="range" min="0" max="0" step="0.01" value="0" data-scrub disabled aria-label="Position in the play" />
        <span class="time num" data-time></span>
      </div>
      <div class="options">
        <div class="group" role="group" aria-label="Speed">
          <button type="button" class="control" data-speed="0.25" aria-pressed="false" disabled>0.25x</button>
          <button type="button" class="control" data-speed="0.5" aria-pressed="false" disabled>0.5x</button>
          <button type="button" class="control" data-speed="1" aria-pressed="true" disabled>1x</button>
        </div>
        <div class="group" role="group" aria-label="Show">
          <button type="button" class="control" data-toggle="stats" aria-pressed="true" disabled>Stats</button>
          <button type="button" class="control" data-toggle="trails" aria-pressed="false" disabled>Routes</button>
          <button type="button" class="control" data-toggle="debug" aria-pressed="false" disabled>Debug</button>
        </div>
      </div>
      <div class="foot">
        <p class="links">
          <a href={url('replays')} data-replay-page>Replay page</a>
          <a href={url('replays/all')}>All replays</a>
        </p>
        <button type="button" class="control another" data-replay-another>Another play</button>
      </div>
    </div>
    <script type="application/json" data-replay-list set:html={embedded} />
  </div>
</Panel>

<script>
  import { initHomeReplay } from '../../lib/replays/home';
  for (const root of document.querySelectorAll<HTMLElement>('[data-home-replay]')) initHomeReplay(root);
</script>

<style>
  .frame {
    container-type: inline-size;
  }

  /* Narrow: title and "Another play", the field, the controls, the links. */
  .home-replay {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'title another'
      'stage stage'
      'controls controls'
      'options options'
      'links links';
    align-items: center;
    gap: var(--space-1) var(--space-2);
    padding: var(--space-2);
  }

  .replay-description,
  .scoreline {
    display: none;
  }

  .foot {
    display: contents;
  }

  .replay-title {
    grid-area: title;
  }

  .another {
    grid-area: another;
  }

  .stage {
    grid-area: stage;
  }

  .controls {
    grid-area: controls;
  }

  .links {
    grid-area: links;
  }

  .options {
    grid-area: options;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .group {
    display: flex;
  }

  .group .control + .control {
    border-left: none;
  }

  /* Wide: the field and controls left, everything about the play right. */
  @container (min-width: 760px) {
    .home-replay {
      grid-template-columns: minmax(0, 540px) minmax(280px, 1fr);
      grid-template-rows: auto auto auto auto 1fr auto;
      grid-template-areas:
        'stage title'
        'stage description'
        'stage scoreline'
        'stage options'
        'stage .'
        'controls foot';
      align-items: start;
      column-gap: var(--space-3);
      row-gap: var(--space-2);
      padding: var(--space-3);
    }

    .replay-description {
      display: -webkit-box;
      grid-area: description;
    }

    .scoreline {
      display: flex;
      grid-area: scoreline;
    }

    .foot {
      grid-area: foot;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2);
      align-self: center;
    }
  }

  .replay-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16px;
    line-height: 1.35;
    height: 1.35em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Five lines, held whether the play's description takes one or eight. */
  .replay-description {
    color: var(--text-dim);
    line-height: 1.35;
    height: calc(5 * 1.35em);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    line-clamp: 5;
    overflow: hidden;
  }

  /* The replay page's scorebug as a slate bar of two set lines: score,
     clock and situation, then win probability, each cut with an ellipsis
     if it runs long. */
  .scoreline {
    flex-direction: column;
    justify-content: center;
    height: calc(2 * 1.35em + 2 * var(--space-1));
    padding: var(--space-1) var(--space-2);
    background: var(--header);
    color: var(--header-text);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15px;
    line-height: 1.35;
  }

  .scoreline :global(.group) {
    display: flex;
    gap: var(--space-3);
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
  }

  .scoreline :global(.cell) {
    padding-left: var(--space-3);
    border-left: 1px solid var(--text-dim);
  }

  .scoreline :global(.cell:last-child) {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .scoreline :global(.group > .cell:only-child) {
    padding-left: 0;
    border-left: none;
  }

  /* The win probability after the play, in place from the start, shown at the last frame. */
  .scoreline :global(.swing) {
    display: inline-block;
    opacity: 0;
  }

  .scoreline :global(.swing.in) {
    opacity: 1;
  }

  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    background: var(--replay-turf-out);
  }

  .replay-canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }

  .layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .caption,
  .status {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    margin: 0;
    padding: 2px var(--space-2);
    background: var(--panel);
    border: 1px solid var(--rule);
    color: var(--header);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15px;
  }

  .status {
    right: var(--space-2);
    left: auto;
    max-width: calc(100% - 2 * var(--space-2));
  }

  /* Slate, not first-down yellow: on a page with live data, yellow means live. */
  .caption[data-kind='touchdown'],
  .caption[data-kind='penalty'] {
    background: var(--header);
    border-color: var(--header);
    color: var(--header-text);
  }

  .tag {
    position: absolute;
    transform: translate(-50%, -100%);
    padding: 0 var(--space-1);
    background: var(--panel);
    border: 1px solid var(--rule);
    color: var(--text);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.35;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 599px) {
    .caption,
    .status {
      font-size: 13px;
    }

    .tag {
      font-size: 10px;
    }
  }

  .controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .links {
    font-size: 12px;
    line-height: 1.35;
  }

  .links a + a {
    margin-left: var(--space-2);
  }

  .control {
    flex: none;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 13px;
    height: 30px;
    padding: 0 var(--space-2);
    border: 1px solid var(--header);
    background: var(--panel);
    color: var(--header);
  }

  .control.primary {
    min-width: 64px;
  }

  .control[aria-pressed='true'],
  .control.primary {
    background: var(--header);
    color: var(--header-text);
  }

  .control:disabled {
    opacity: 0.6;
  }

  .scrub {
    flex: 1 1 auto;
    min-width: 0;
    accent-color: var(--header);
  }

  .time {
    flex: none;
    color: var(--text-dim);
    font-size: 12px;
    min-width: 16ch;
    text-align: right;
  }
</style>
