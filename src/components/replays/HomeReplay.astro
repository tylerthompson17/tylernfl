---
/**
 * The home page's Retro Replay: one of the featured replays at random on
 * each visit, picked in the browser (src/lib/replays/home.ts), which loads
 * that play's scene and the player only then. The page carries the short
 * list alone. Every part has its size before anything loads (one title
 * line, two description lines, the scoreline's lines, the 3:2 canvas, the
 * controls), so nothing shifts. The caller renders this only when the
 * build has featured replays.
 */
import Panel from '../Panel.astro';
import type { FeaturedReplay } from '../../lib/replays/pick';
import { url } from '../../utils/url';

interface Props {
  replays: FeaturedReplay[];
}

const { replays } = Astro.props;
// "</script>" can never appear in JSON.stringify output once "<" is escaped.
const embedded = JSON.stringify(replays).replace(/</g, '\\u003c');
---

<Panel title="Retro Replay">
  <div class="home-replay" data-home-replay>
    <p class="replay-title" data-replay-title></p>
    <p class="replay-description" data-replay-description></p>
    <div class="scoreline" data-replay-scoreline></div>
    <div class="stage">
      <canvas class="replay-canvas" width="504" height="336" data-canvas role="img" aria-label="Pixel art replay drawn from player tracking"
      ></canvas>
      <div class="layer" aria-hidden="true">
        <p class="caption" data-caption hidden></p>
        <span class="tag" data-tag="speed" hidden></span>
        <span class="tag" data-tag="air" hidden></span>
        <span class="tag" data-tag="separation" hidden></span>
      </div>
      <p class="status" data-replay-status role="status">Loading the replay…</p>
      <noscript><p class="status">The replay needs JavaScript.</p></noscript>
    </div>
    <div class="controls">
      <button type="button" class="control primary" data-play disabled>Play</button>
      <button type="button" class="control" data-restart disabled>Restart</button>
      <input class="scrub" type="range" min="0" max="0" step="0.01" value="0" data-scrub disabled aria-label="Position in the play" />
      <span class="time num" data-time></span>
    </div>
    <div class="foot">
      <p class="links">
        <a href={url('replays')} data-replay-page>Replay page</a>
        <a href={url('replays/all')}>All replays</a>
      </p>
      <button type="button" class="control" data-replay-another>Another play</button>
    </div>
    <script type="application/json" data-replay-list set:html={embedded} />
  </div>
</Panel>

<script>
  import { initHomeReplay } from '../../lib/replays/home';
  for (const root of document.querySelectorAll<HTMLElement>('[data-home-replay]')) initHomeReplay(root);
</script>

<style>
  .replay-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16px;
    line-height: 1.35;
    height: 1.35em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Two lines, held whether the play's description takes one or five. */
  .replay-description {
    color: var(--text-dim);
    height: calc(2 * 1.35em);
    margin-bottom: var(--space-2);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .home-replay {
    container-type: inline-size;
  }

  /* The replay page's scorebug as a slate bar: one line from 640px of
     panel (the widest featured play's needs 515px), else score, clock and
     situation on one and win probability on the next. Its height depends
     only on the panel's width, so filling it shifts nothing; a line too
     long for it is cut with an ellipsis. */
  .scoreline {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: calc(2 * 1.35em + 2 * var(--space-1));
    padding: var(--space-1) var(--space-2);
    background: var(--header);
    color: var(--header-text);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15px;
    line-height: 1.35;
  }

  @container (min-width: 640px) {
    .scoreline {
      flex-direction: row;
      justify-content: flex-start;
      align-items: center;
      gap: var(--space-3);
      height: calc(1.35em + 2 * var(--space-1));
    }

    .scoreline :global(.group + .group) {
      padding-left: var(--space-3);
      border-left: 1px solid var(--text-dim);
    }
  }

  .scoreline :global(.group) {
    display: flex;
    gap: var(--space-3);
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
  }

  .scoreline :global(.cell) {
    padding-left: var(--space-3);
    border-left: 1px solid var(--text-dim);
  }

  .scoreline :global(.cell:last-child) {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .scoreline :global(.group > .cell:only-child) {
    padding-left: 0;
    border-left: none;
  }

  /* The win probability after the play, in place from the start, shown at the last frame. */
  .scoreline :global(.swing) {
    display: inline-block;
    opacity: 0;
  }

  .scoreline :global(.swing.in) {
    opacity: 1;
  }

  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    background: var(--replay-turf-out);
  }

  .replay-canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }

  .layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .caption,
  .status {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    margin: 0;
    padding: 2px var(--space-2);
    background: var(--panel);
    border: 1px solid var(--rule);
    color: var(--header);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15px;
  }

  .status {
    right: var(--space-2);
    left: auto;
    max-width: calc(100% - 2 * var(--space-2));
  }

  .caption[data-kind='touchdown'],
  .caption[data-kind='penalty'] {
    background: var(--highlight);
  }

  .tag {
    position: absolute;
    transform: translate(-50%, -100%);
    padding: 0 var(--space-1);
    background: var(--panel);
    border: 1px solid var(--rule);
    color: var(--text);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.35;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 599px) {
    .caption,
    .status {
      font-size: 13px;
    }

    .tag {
      font-size: 10px;
    }
  }

  .controls,
  .foot {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .foot {
    justify-content: space-between;
    padding-top: var(--space-2);
    border-top: 1px dotted var(--rule-soft);
  }

  .links {
    font-size: 12px;
  }

  .links a + a {
    margin-left: var(--space-2);
  }

  .control {
    flex: none;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 13px;
    min-height: 30px;
    padding: 0 var(--space-2);
    border: 1px solid var(--header);
    background: var(--panel);
    color: var(--header);
  }

  .control.primary {
    min-width: 64px;
    background: var(--header);
    color: var(--header-text);
  }

  .control:disabled {
    opacity: 0.6;
  }

  .scrub {
    flex: 1 1 auto;
    min-width: 0;
    accent-color: var(--header);
  }

  .time {
    flex: none;
    color: var(--text-dim);
    font-size: 12px;
    min-width: 16ch;
    text-align: right;
  }
</style>
