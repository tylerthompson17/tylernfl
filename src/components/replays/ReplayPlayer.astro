---
/**
 * A Retro Replay in a panel: the scorebug as the panel's header bar, the
 * pixel art canvas with captions and stat labels over it in the site's
 * type, and the controls. The scene is embedded;
 * src/lib/replays/player.ts draws it. The pixel art stays inside the
 * canvas; everything around it is the site's design.
 */
import TeamChip from '../TeamChip.astro';
import type { ReplayScene } from '../../data/types';
import { goalToGo, penaltyText, scorebugSituation, wpNumbers, wpSwingReadout } from '../../lib/replays/words';

interface Props {
  scene: ReplayScene;
  /** Frame to show first (the replay still waits for Play) */
  start?: number;
}

const { scene, start = 0 } = Astro.props;
const { play } = scene;
const goal = goalToGo(scene.field);
const penalty = penaltyText(play.penalty);
const ORDINAL = ['1st', '2nd', '3rd', '4th'];
const swing = wpSwingReadout(play);
const wpShown =
  play.wpBefore === null ? null : play.wpAfter === null ? `${Math.round(play.wpBefore * 100)}%` : wpNumbers(play.wpBefore, play.wpAfter).before;
// "</script>" can never appear in JSON.stringify output once "<" is escaped.
const embedded = JSON.stringify(scene).replace(/</g, '\\u003c');
---

<section class="replay" data-replay data-start={start} data-penalty={penalty ?? undefined}>
  <div class="scorebug">
    <span class="team">
      <TeamChip abbr={play.away} size="sm" />
      <span class="num" data-score="away">{play.scoreBefore.away}</span>
    </span>
    <span class="team">
      <TeamChip abbr={play.home} size="sm" />
      <span class="num" data-score="home">{play.scoreBefore.home}</span>
    </span>
    <span class="cell num" data-clock>{ORDINAL[play.quarter - 1] ?? 'OT'} {play.clock.replace(/^0(?=\d:)/, '')}</span>
    <span class="cell">{scorebugSituation(play, goal)}</span>
    {
      wpShown && (
        <span class="cell num">
          {play.featured} win prob {wpShown}
          {swing && <span class="swing" data-swing aria-hidden="true">{swing}</span>}
        </span>
      )
    }
  </div>
  <div class="stage">
    <canvas
      class="replay-canvas"
      width="504"
      height="336"
      data-canvas
      role="img"
      aria-label={`Pixel art replay drawn from player tracking: ${play.description}`}
    ></canvas>
    <div class="layer" aria-hidden="true">
      <p class="caption" data-caption hidden></p>
      <span class="tag" data-tag="speed" hidden></span>
      <span class="tag" data-tag="air" hidden></span>
      <span class="tag" data-tag="separation" hidden></span>
      <span class="tag" data-tag="carrier" hidden></span>
    </div>
  </div>
  <noscript><p class="note">The replay needs JavaScript.</p></noscript>
  <div class="controls" data-controls hidden>
    <div class="row">
      <button type="button" class="control primary" data-play>Play</button>
      <button type="button" class="control" data-restart>Restart</button>
      <div class="group" role="group" aria-label="Speed">
        <button type="button" class="control" data-speed="0.25" aria-pressed="false">0.25x</button>
        <button type="button" class="control" data-speed="0.5" aria-pressed="false">0.5x</button>
        <button type="button" class="control" data-speed="1" aria-pressed="true">1x</button>
      </div>
      <div class="group" role="group" aria-label="Show">
        <button type="button" class="control" data-toggle="stats" aria-pressed="true">Stats</button>
        <button type="button" class="control" data-toggle="trails" aria-pressed="false">Routes</button>
        <button type="button" class="control" data-toggle="debug" aria-pressed="false">Debug</button>
      </div>
    </div>
    <div class="row">
      <input class="scrub" type="range" min="0" max="0" step="0.01" value="0" data-scrub aria-label="Position in the play" />
      <span class="time num" data-time></span>
    </div>
  </div>
  <script type="application/json" data-scene set:html={embedded} />
</section>

<script>
  import { initReplay } from '../../lib/replays/player';
  for (const root of document.querySelectorAll<HTMLElement>('[data-replay]')) initReplay(root);
</script>

<style>
  .replay {
    background: var(--panel);
    border: 1px solid var(--rule);
    margin-bottom: var(--space-3);
    min-width: 0;
  }

  /* The scorebug is the panel's header bar: slate, white, the heading face. */
  .scorebug {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    padding: var(--header-pad);
    background: var(--header);
    color: var(--header-text);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15px;
  }

  .team {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* A thin light edge, so a dark team color still reads on the slate bar. */
  .team :global(.chip) {
    outline: 1px solid var(--rule);
  }

  .cell {
    padding-left: var(--space-3);
    border-left: 1px solid var(--text-dim);
  }

  /* The win probability after the play: in place from the start (so the bar
     never shifts), shown when the replay reaches its last frame. */
  .swing {
    display: inline-block;
    margin-left: var(--space-1);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.3s ease-out,
      transform 0.3s ease-out;
  }

  .swing.in {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .swing {
      transition: none;
    }
  }

  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
  }

  .replay-canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    background: var(--replay-turf-out);
  }

  .layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .caption {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    margin: 0;
    padding: 2px var(--space-2);
    background: var(--panel);
    border: 1px solid var(--rule);
    color: var(--header);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15px;
  }

  /* Slate, not first-down yellow: on a page with live data, yellow means live. */
  .caption[data-kind='touchdown'],
  .caption[data-kind='penalty'] {
    background: var(--header);
    border-color: var(--header);
    color: var(--header-text);
  }

  .tag {
    position: absolute;
    transform: translate(-50%, -100%);
    padding: 0 var(--space-1);
    background: var(--panel);
    border: 1px solid var(--rule);
    color: var(--text);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.35;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 599px) {
    .caption {
      font-size: 13px;
    }

    .tag {
      font-size: 10px;
    }
  }

  .note {
    padding: var(--space-3);
  }

  .controls {
    padding: var(--space-2) var(--space-3) var(--space-3);
    border-top: 1px solid var(--rule);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .row + .row {
    margin-top: var(--space-2);
  }

  .group {
    display: flex;
  }

  .group .control + .control {
    border-left: none;
  }

  .control {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 13px;
    min-height: 30px;
    padding: 0 var(--space-2);
    border: 1px solid var(--header);
    background: var(--panel);
    color: var(--header);
  }

  .control.primary {
    min-width: 64px;
  }

  .control[aria-pressed='true'],
  .control.primary {
    background: var(--header);
    color: var(--header-text);
  }

  .scrub {
    flex: 1 1 200px;
    accent-color: var(--header);
  }

  .time {
    color: var(--text-dim);
    font-size: 12px;
    min-width: 9ch;
    text-align: right;
  }
</style>
