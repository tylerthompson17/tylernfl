---
/**
 * A team's roster moves and injury report for the week. With a limit, the
 * top of it (news before routine items, starters first), linking to the
 * team's Transactions tab for the rest.
 */
import Panel from '../Panel.astro';
import StatTable from '../StatTable.astro';
import type { Team } from '../../data/types';
import { INJURY_NOTE, MOVES_NOTE, SNAPS_NOTE, transactions, wireItems } from '../../utils/transactions';
import { url } from '../../utils/url';

interface Props {
  team: Team;
  limit?: number;
}

const { team, limit } = Astro.props;
const all = wireItems(team.abbr);
const items = limit ? all.slice(0, limit) : all;
const columns = [
  { key: 'player', label: 'Player', kind: 'player' as const, slugKey: 'slug' },
  { key: 'position', label: 'Pos' },
  ...(limit ? [] : [{ key: 'snaps', label: 'Snaps', kind: 'number' as const }, { key: 'categoryLabel', label: 'Type' }]),
  { key: 'news', label: 'News' },
];
const title = transactions.week === null ? 'Transactions and injuries' : `Week ${transactions.week} transactions and injuries`;
---

<Panel title={title}>
  {
    transactions.week === null ? (
      <p class="placeholder-note">Offseason. Roster moves and injury reports return in week 1.</p>
    ) : (
      <>
        <StatTable
          columns={columns}
          rows={items}
          caption={`${team.name} transactions and injury report`}
          emptyText={`No ${team.name} roster moves or injury report entries this week.`}
        />
        {limit ? (
          <p class="table-foot">
            {all.length > items.length ? `${all.length - items.length} more. ` : ''}
            <a href={url(`teams/${team.abbr}/transactions`)}>All {team.name} moves and injuries</a>
          </p>
        ) : (
          <>
            <p class="table-foot">{SNAPS_NOTE}</p>
            <p class="table-foot">{MOVES_NOTE} {INJURY_NOTE}</p>
            <p class="table-foot">
              <a href={`${url('transactions')}?team=${team.abbr}`}>{team.name} on the full wire</a>, with every
              team's moves to compare.
            </p>
          </>
        )}
      </>
    )
  }
</Panel>

<style>
  .table-foot {
    margin-top: var(--space-2);
    color: var(--text-dim);
    font-size: 12px;
  }
</style>
