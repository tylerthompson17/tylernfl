---
/** A team's best player in each stat leaders category, with his league rank. */
import Panel from '../Panel.astro';
import StatTable from '../StatTable.astro';
import type { Team } from '../../data/types';
import { boardSeason, teamLeaders } from '../../utils/overview';
import { url } from '../../utils/url';

interface Props {
  team: Team;
}

const { team } = Astro.props;
const leaders = teamLeaders(team.abbr);
const columns = [
  { key: 'category', label: 'Category' },
  { key: 'player', label: 'Player', kind: 'player' as const, slugKey: 'slug' },
  { key: 'value', label: 'Value', kind: 'number' as const },
  { key: 'rank', label: 'NFL rank', kind: 'number' as const },
];
---

<Panel title="Team leaders">
  <StatTable
    columns={columns}
    rows={leaders}
    caption={`${team.name} leaders in each category, with league rank`}
    emptyText="No games played yet. Leaders appear after week 1."
  />
  <p class="table-foot">
    {boardSeason() ?? ''} regular season. The EPA categories count qualified players only.{' '}
    <a href={url('stats')}>League leaders</a>
  </p>
</Panel>

<style>
  .table-foot {
    margin-top: var(--space-2);
    color: var(--text-dim);
    font-size: 12px;
  }
</style>
