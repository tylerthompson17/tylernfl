---
/**
 * A team's playoff odds on its overview: making the playoffs, winning the
 * division, the top seed, each seed 1 to 7, and projected wins, with the
 * label saying where the game probabilities come from.
 */
import Panel from '../Panel.astro';
import type { Team } from '../../data/types';
import { formatChance, oddsLabel } from '../../lib/teams/odds';
import { oddsOf, playoffOdds } from '../../utils/teams';

interface Props {
  team: Team;
}

const { team } = Astro.props;
const odds = oddsOf(team.abbr);
---

{
  odds && (
    <Panel title="Playoff odds">
      <dl class="headline">
        <div>
          <dt>Make the playoffs</dt>
          <dd class="num">{formatChance(odds.playoffs)}</dd>
        </div>
        <div>
          <dt>Win the division</dt>
          <dd class="num">{formatChance(odds.division)}</dd>
        </div>
        <div>
          <dt>Top seed</dt>
          <dd class="num">{formatChance(odds.topSeed)}</dd>
        </div>
        <div>
          <dt>Projected wins</dt>
          <dd class="num">{odds.meanWins.toFixed(1)}</dd>
        </div>
      </dl>
      <div class="stat-table-scroll" tabindex="0">
        <table class="stat-table">
          <caption class="visually-hidden">{team.name} chance of each playoff seed</caption>
          <thead>
            <tr>
              <th scope="row">Seed</th>
              {odds.seeds.map((_, i) => <th scope="col" class="number">{i + 1}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Chance</th>
              {odds.seeds.map((p) => <td class="number">{formatChance(p)}</td>)}
            </tr>
          </tbody>
        </table>
      </div>
      <p class="table-foot">
        {oddsLabel(playoffOdds.pricedGames, playoffOdds.remainingGames)}{' '}
        {`${playoffOdds.simulations.toLocaleString('en-US')} simulations of the ${playoffOdds.remainingGames} remaining games (${playoffOdds.pricedGames} with a line), seeded with the NFL's tiebreakers. Simulated games never end in a tie.`}
      </p>
    </Panel>
  )
}

<style>
  .headline {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0 0 var(--space-3);
    border: 1px solid var(--rule);
  }

  .headline > div {
    padding: var(--space-2);
  }

  .headline > div + div {
    border-left: 1px solid var(--rule);
  }

  dt {
    color: var(--text-dim);
    font-size: 12px;
  }

  dd {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
  }

  .table-foot {
    margin-top: var(--space-2);
    color: var(--text-dim);
    font-size: 12px;
  }
</style>
