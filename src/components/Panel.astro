---
/**
 * One panel on the gray page: 1px border, slate header bar with a white
 * title, white body. `flush` removes body padding for content that
 * manages its own (rare now that tables are boxed units inside the body).
 */
interface Props {
  title?: string;
  flush?: boolean;
  /** Extra class for grid placement by the parent page */
  class?: string;
  /** id for the title, for content that names itself by it (a chart) */
  titleId?: string;
}

const { title, flush = false, class: className, titleId } = Astro.props;
---

<section class:list={['panel', className]}>
  {title && <h2 class="panel-title" id={titleId}>{title}</h2>}
  <div class:list={['panel-body', { flush }]}>
    <slot />
  </div>
</section>

<style>
  .panel {
    background: var(--panel);
    border: 1px solid var(--rule);
    min-width: 0;
  }

  .panel-title {
    font-size: 15px;
    padding: var(--header-pad);
    background: var(--header);
    color: var(--header-text);
  }

  .panel-body {
    padding: var(--space-3);
  }

  .panel-body.flush {
    padding: 0;
  }
</style>
