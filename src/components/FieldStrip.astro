---
/**
 * A 4th down on the field strip (src/lib/field/strip.ts, which the
 * calculator's script also draws from): offense driving left to right,
 * both end zones, the line of scrimmage, the line to gain and, when a field
 * goal is an option, its distance. One image to a screen reader, described
 * in words.
 */
import { fieldStripHtml } from '../lib/field/strip';

interface Props {
  /** Yards from the opponent's goal line, 1 to 99 */
  yardline100: number;
  /** Yards to go; at or past the goal line is goal to go */
  distance: number;
  /** The field goal's distance when one is an option */
  kick?: number | null;
  /** Shown above the field, e.g. "4th and 3" */
  label: string;
}

const { yardline100, distance, kick = null, label } = Astro.props;
---

<Fragment set:html={fieldStripHtml({ yardline100, distance, kick, label })} />
