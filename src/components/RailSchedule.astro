---
/**
 * This week's games for the right rail, in kickoff order: the kickoff in
 * the visitor's time zone, or the clock, or the final score with the
 * winner in bold. Rows carry the same data-game hooks as the ticker, so
 * the live scores poll (src/lib/live-ticker/client.ts) updates them too;
 * nothing extra is fetched.
 */
import tickerData from '../data/ticker.json';
import type { TickerData, TickerGame } from '../data/types';
import { url } from '../utils/url';
import { weekLabel } from '../utils/week';
import Panel from './Panel.astro';

const ticker = tickerData as TickerData;
const games = [...ticker.games].sort(
  (a, b) => (a.kickoff ? Date.parse(a.kickoff) : Infinity) - (b.kickoff ? Date.parse(b.kickoff) : Infinity)
);
const week = weekLabel(ticker.week);

function won(game: TickerGame, side: 'away' | 'home'): boolean {
  if (game.state !== 'final' || game.awayScore == null || game.homeScore == null) return false;
  return side === 'away' ? game.awayScore > game.homeScore : game.homeScore > game.awayScore;
}

let opener: string | null = null;
if (ticker.nextOpener) {
  const [y, m, d] = ticker.nextOpener.split('-').map(Number);
  opener = new Date(y!, m! - 1, d!).toLocaleDateString('en-US', { month: 'long', day: 'numeric' });
}
---

<Panel title={week ? `${week} games` : 'This week'}>
  {
    games.length === 0 ? (
      <p class="placeholder-note">{opener ? `Offseason. The next season opens ${opener}.` : 'No games this week.'}</p>
    ) : (
      <>
        <ul class="games">
          {games.map((game) => (
            <li class="game" data-game data-state={game.state} data-espn-id={game.espnId ?? undefined} data-kickoff={game.kickoff ?? undefined}>
              <span class:list={['detail', { live: game.state === 'live' }]} data-detail>{game.detail}</span>
              <span class:list={['side', { won: won(game, 'away') }]} data-side="away" data-team={game.away}>
                <a href={url(`teams/${game.away}`)}>{game.away}</a>
                <span class="num" data-score>{game.awayScore ?? ''}</span>
              </span>
              <span class="visually-hidden">at</span>
              <span class:list={['side', { won: won(game, 'home') }]} data-side="home" data-team={game.home}>
                <a href={url(`teams/${game.home}`)}>{game.home}</a>
                <span class="num" data-score>{game.homeScore ?? ''}</span>
              </span>
            </li>
          ))}
        </ul>
        <p class="foot">
          Kickoff times are in your time zone. <a href={url('scores')}>Full scoreboard</a>
        </p>
      </>
    )
  }
</Panel>

<style>
  .games {
    list-style: none;
    padding: 0;
  }

  .game {
    display: grid;
    grid-template-columns: 84px 1fr 1fr;
    align-items: center;
    column-gap: var(--space-2);
    padding: 3px 0;
    font-size: 12px;
  }

  .game + .game {
    border-top: 1px dotted var(--rule-soft);
  }

  .detail {
    color: var(--text-dim);
    font-family: var(--font-heading);
    white-space: nowrap;
    justify-self: start;
  }

  .detail.live {
    background: var(--highlight);
    color: var(--text);
    padding: 0 var(--space-1);
  }

  .side {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    font-family: var(--font-heading);
    font-size: 13px;
  }

  .side + .visually-hidden + .side {
    padding-left: var(--space-2);
    border-left: 1px solid var(--rule-soft);
  }

  .side.won {
    font-weight: 700;
  }

  /* Scoreboard chrome, like the ticker: team links keep text color and
     underline on hover. */
  .side a {
    color: inherit;
    text-decoration: none;
  }

  .side a:hover {
    text-decoration: underline;
  }

  .foot {
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px dotted var(--rule-soft);
    font-size: 12px;
    color: var(--text-dim);
  }
</style>
