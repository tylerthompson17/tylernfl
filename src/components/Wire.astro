---
/**
 * The full transactions wire: every roster move and injury report entry,
 * biggest news first. Renders the complete table so it works without
 * JavaScript; the script adds filters by team, category and starters (see
 * src/lib/wire/dom.ts). Styles are the shared .stat-table rules.
 */
import TeamChip from './TeamChip.astro';
import teamsData from '../data/teams.json';
import type { TeamsData } from '../data/types';
import type { WireItem } from '../utils/transactions';
import { url } from '../utils/url';

interface Props {
  items: WireItem[];
  categories: { key: string; label: string }[];
}

const { items, categories } = Astro.props;
const teams = [...(teamsData as TeamsData)].sort((a, b) => a.name.localeCompare(b.name));
---

<div class="wire" data-wire>
  <div class="controls" data-wire-controls hidden>
    <div class="row">
      <label>
        Team
        <select data-wire-team>
          <option value="">All teams</option>
          {teams.map((team) => <option value={team.abbr}>{team.name}</option>)}
        </select>
      </label>
      <label class="check">
        <input type="checkbox" data-wire-starters />
        Starters only
      </label>
    </div>
    <div class="chips" role="group" aria-label="Type">
      <button type="button" data-wire-category="" aria-pressed="true">
        All <span class="count" data-count>{items.length}</span>
      </button>
      {
        categories.map((category) => (
          <button type="button" data-wire-category={category.key} aria-pressed="false">
            {category.label} <span class="count" data-count />
          </button>
        ))
      }
    </div>
  </div>
  <p class="status" data-wire-status aria-live="polite">{items.length} items.</p>
  <div class="stat-table-scroll" tabindex="0">
    <table class="stat-table">
      <caption class="visually-hidden">Transactions and injury report</caption>
      <thead>
        <tr>
          <th scope="col">Team</th>
          <th scope="col">Player</th>
          <th scope="col">Pos</th>
          <th scope="col" class="number" title="Share of snaps over his last 8 games">Snaps</th>
          <th scope="col">Type</th>
          <th scope="col">News</th>
        </tr>
      </thead>
      <tbody>
        {
          items.map((item) => (
            <tr
              data-team={item.team}
              data-from-team={item.fromTeam ?? ''}
              data-category={item.category}
              data-starter={item.starter ? '1' : '0'}
            >
              <td>
                <TeamChip abbr={item.team} size="sm" />
              </td>
              <td>
                <a href={url(`players/${item.slug}`)}>{item.player}</a>
              </td>
              <td>{item.position}</td>
              <td class="number">{item.snaps}</td>
              <td>{item.categoryLabel}</td>
              <td>{item.news}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="stat-table-empty empty" data-wire-empty hidden>Nothing matches these filters.</p>
</div>

<script>
  import { initWires } from '../lib/wire/dom';
  initWires();
</script>

<style>
  .controls {
    margin-bottom: var(--space-2);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
  }

  .check {
    font-weight: 400;
  }

  select {
    font: inherit;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--rule);
    background: var(--panel);
    color: var(--text);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .chips button {
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--rule);
    background: var(--panel);
  }

  .chips button[aria-pressed='true'] {
    background: var(--header);
    border-color: var(--header);
    color: var(--header-text);
    font-weight: 700;
  }

  .chips button[hidden] {
    display: none;
  }

  .count {
    color: inherit;
    opacity: 0.75;
    font-variant-numeric: tabular-nums;
  }

  .status {
    color: var(--text-dim);
    margin-bottom: var(--space-2);
  }

  .empty {
    margin-top: var(--space-2);
  }
</style>
